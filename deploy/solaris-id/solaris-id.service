[Unit]
Description=Solaris ID API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=solaris-id
Group=solaris-id
WorkingDirectory=/opt/solaris-id
EnvironmentFile=/etc/solaris-id/api.env
ExecStart=/usr/bin/dotnet /opt/solaris-id/Solaris.Id.Api.dll
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/solaris-id
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
