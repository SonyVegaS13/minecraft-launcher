# TEMPLATE ONLY. Copy outside the checkout to /etc/solaris-id/api.env (0600).
# Replace the domain and credentials through the hosting secret manager.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://0.0.0.0:443
Kestrel__Certificates__Default__Path=/etc/solaris-id/tls/fullchain.pem
Kestrel__Certificates__Default__KeyPath=/etc/solaris-id/tls/privkey.pem
SOLARIS_ID_PUBLIC_ORIGIN=https://YOUR_AUTH_DOMAIN
SOLARIS_ID_CONNECTION_STRING=Host=127.0.0.1;Database=solaris_id;Username=solaris_app;Password=REPLACE_SECURELY
SOLARIS_ID_DATA_PROTECTION_KEYS=/var/lib/solaris-id/keys
SOLARIS_SMTP_HOST=YOUR_SMTP_HOST
SOLARIS_SMTP_PORT=587
SOLARIS_SMTP_FROM=YOUR_VERIFIED_FROM_ADDRESS
SOLARIS_SMTP_USER=REPLACE_SECURELY
SOLARIS_SMTP_PASSWORD=REPLACE_SECURELY
# Populate separate random keys ONLY on the API host and the matching server.
# Never ship them in launcher config. [] keeps all game audiences unavailable.
SOLARIS_GAME_SERVERS=[]
