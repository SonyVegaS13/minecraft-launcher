<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SolarisLauncher</AssemblyName>
    <ApplicationIcon>Assets\SolarisLauncher.ico</ApplicationIcon>
    <RootNamespace>SolarisLauncher</RootNamespace>
    <Platforms>AnyCPU</Platforms>

    <!-- Release defaults: standalone Windows x64 executable. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <AssemblyVersion>2.2.10.0</AssemblyVersion>
    <FileVersion>2.2.10.0</FileVersion>
    <Version>2.2.10</Version>
  </PropertyGroup>

  <!-- Explicit opt-in DEV binary branding: only CI DEV artifacts get this flag.
       Stable release builds never inherit the DEV updater or install path. -->
  <PropertyGroup Condition="'$(SolarisChannel)' == 'dev'">
    <DefineConstants>$(DefineConstants);SOLARIS_DEV_DISTRIBUTION</DefineConstants>
  </PropertyGroup>

  <!-- The independent ASP.NET Core Solaris ID server has its own .csproj. -->
  <ItemGroup>
    <Compile Remove="backend\**\*.cs" />
    <Compile Remove="vendor\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SolarisEmber.bmp" />
    <Resource Include="Assets\SolarisOfficialLogo.png" />
    <!-- Approved compact icon for the Solaris Modded server tile. -->
    <Resource Include="Assets\SolarisModdedIcon.png" />
    <!-- These files are extracted and SHA256-verified from the approved ZIP before CI build. -->
    <Resource Include="Assets\SolarisWorld.png" Condition="Exists('Assets\SolarisWorld.png')" />
    <Resource Include="Assets\SolarisModded.png" Condition="Exists('Assets\SolarisModded.png')" />
    <Resource Include="Assets\SolarisVanillaCard.png" Condition="Exists('Assets\SolarisVanillaCard.png')" />
    <Resource Include="Assets\SolarisModdedCard.png" Condition="Exists('Assets\SolarisModdedCard.png')" />
    <!-- Optional native WPF layers. Prepared outputs are preferred; a direct
         approved PNG also works without a Python preparation step. Never embed
         the original and prepared copy of the same layer twice. -->
    <Resource Include="Assets\Planetary\Prepared\*.png" />
    <Resource Include="Assets\Planetary\space-background.png" Condition="Exists('Assets\Planetary\space-background.png') and !Exists('Assets\Planetary\Prepared\space-background.png')" />
    <Resource Include="Assets\Planetary\bridge-foreground.png" Condition="Exists('Assets\Planetary\bridge-foreground.png') and !Exists('Assets\Planetary\Prepared\bridge-foreground.png')" />
    <Resource Include="Assets\Planetary\operator-body.png" Condition="Exists('Assets\Planetary\operator-body.png') and !Exists('Assets\Planetary\Prepared\operator-body.png')" />
    <Resource Include="Assets\Planetary\operator-head.png" Condition="Exists('Assets\Planetary\operator-head.png') and !Exists('Assets\Planetary\Prepared\operator-head.png')" />
    <Resource Include="Assets\Planetary\vanilla-surface.png" Condition="Exists('Assets\Planetary\vanilla-surface.png') and !Exists('Assets\Planetary\Prepared\vanilla-surface.png')" />
    <Resource Include="Assets\Planetary\vanilla-atmosphere.png" Condition="Exists('Assets\Planetary\vanilla-atmosphere.png') and !Exists('Assets\Planetary\Prepared\vanilla-atmosphere.png')" />
    <Resource Include="Assets\Planetary\modded-surface.png" Condition="Exists('Assets\Planetary\modded-surface.png') and !Exists('Assets\Planetary\Prepared\modded-surface.png')" />
    <Resource Include="Assets\Planetary\modded-atmosphere.png" Condition="Exists('Assets\Planetary\modded-atmosphere.png') and !Exists('Assets\Planetary\Prepared\modded-atmosphere.png')" />
    <Resource Include="Assets\Planetary\modded-rings-back.png" Condition="Exists('Assets\Planetary\modded-rings-back.png') and !Exists('Assets\Planetary\Prepared\modded-rings-back.png')" />
    <Resource Include="Assets\Planetary\modded-rings-front.png" Condition="Exists('Assets\Planetary\modded-rings-front.png') and !Exists('Assets\Planetary\Prepared\modded-rings-front.png')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="vendor\ForgeInstaller\ForgeInstaller.csproj" />
  </ItemGroup>

</Project>
