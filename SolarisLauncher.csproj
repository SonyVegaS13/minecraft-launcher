<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SolarisLauncher</AssemblyName>
    <ApplicationIcon>Assets\SolarisLauncher.ico</ApplicationIcon>
    <RootNamespace>SolarisLauncher</RootNamespace>
    <Platforms>AnyCPU</Platforms>

    <!-- Release defaults: standalone Windows x64 executable. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <AssemblyVersion>2.2.15.0</AssemblyVersion>
    <FileVersion>2.2.15.0</FileVersion>
    <Version>2.2.15</Version>
  </PropertyGroup>

  <!-- Explicit opt-in DEV binary branding: only CI DEV artifacts get this flag.
       Stable release builds never inherit the DEV updater or install path. -->
  <PropertyGroup Condition="'$(SolarisChannel)' == 'dev'">
    <DefineConstants>$(DefineConstants);SOLARIS_DEV_DISTRIBUTION</DefineConstants>
  </PropertyGroup>

  <!-- Separate artifact only. The normal release updater/channel is unchanged. -->
  <PropertyGroup Condition="'$(SolarisTestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);SOLARIS_ID_TEST_BUILD</DefineConstants>
    <AssemblyName>SolarisLauncher.IdTest</AssemblyName>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <!-- The independent ASP.NET Core Solaris ID server has its own .csproj. -->
  <ItemGroup>
    <Compile Remove="backend\**\*.cs" />
    <Compile Remove="vendor\**\*.cs" />
    <!-- Independent cross-platform/API test harnesses are not WPF application code. -->
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SolarisEmber.bmp" />
    <Resource Include="Assets\SolarisOfficialLogo.png" />
    <!-- Static cosmic background and exact title from the approved user video. -->
    <Resource Include="Assets\SolarisCosmicHome.jpg" />
    <Resource Include="Assets\SolarisCosmicTitle.png" />
    <!-- Approved compact icon for the Solaris Modded server tile. -->
    <Resource Include="Assets\SolarisModdedIcon.png" />
    <!-- These files are extracted and SHA256-verified from the approved ZIP before CI build. -->
    <Resource Include="Assets\SolarisWorld.png" Condition="Exists('Assets\SolarisWorld.png')" />
    <Resource Include="Assets\SolarisModded.png" Condition="Exists('Assets\SolarisModded.png')" />
    <Resource Include="Assets\SolarisVanillaCard.png" Condition="Exists('Assets\SolarisVanillaCard.png')" />
    <Resource Include="Assets\SolarisModdedCard.png" Condition="Exists('Assets\SolarisModdedCard.png')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="vendor\ForgeInstaller\ForgeInstaller.csproj" />
  </ItemGroup>

</Project>
