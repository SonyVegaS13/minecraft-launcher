<Window x:Class="SolarisLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solaris Launcher" Width="1180" Height="760" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#070910" Foreground="#F5F7FA" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0F131D"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#141925"/>
        <SolidColorBrush x:Key="Panel3Brush" Color="#0B0F17"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#252C3A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8993A5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#A078FF"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/><Setter Property="Padding" Value="20,0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="{StaticResource Panel2Brush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#AAB3C2"/><Setter Property="Padding" Value="10,7"/></Style>
        <Style x:Key="InputBox" TargetType="TextBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#0C111A"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#0C111A"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="AvatarRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Width="122" Height="116" Background="#121722" BorderBrush="#252B38" BorderThickness="1" CornerRadius="14" Padding="10"><StackPanel HorizontalAlignment="Center"><Border Width="54" Height="54" CornerRadius="27" Background="#8B5CF6"><TextBlock Text="S" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#A078FF"/><Setter TargetName="Card" Property="Background" Value="#1A1730"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid x:Name="AuthView">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="24,0,70,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="54" Height="54" CornerRadius="16" Background="{StaticResource AccentBrush}" Margin="0,0,15,0"><TextBlock Text="☀" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="SOLARIS" FontSize="38" FontWeight="Bold"/><TextBlock Text="MINECRAFT UNIVERSE" FontSize="11" Foreground="#70798B" Margin="1,2,0,0"/></StackPanel>
                </StackPanel>
                <TextBlock Text="Твой Minecraft. Твой мир. Твой Solaris." FontSize="24" FontWeight="SemiBold" Margin="0,40,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Один лаунчер для Vanilla и Modded приключений." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                <Border Margin="0,30,0,0" Padding="18" Background="#10151F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                    <StackPanel><TextBlock Text="☀  SOLARIS VANILLA" FontSize="13" FontWeight="SemiBold" Foreground="#F6C85F"/><TextBlock Text="Minecraft 26.2 • Survival" FontSize="12" Foreground="#AEB6C5" Margin="0,7,0,0"/><TextBlock Text="solarisplay.millida.host:25565" FontSize="10" Foreground="#667082" Margin="0,5,0,0"/></StackPanel>
                </Border>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="34" VerticalAlignment="Center">
                <StackPanel><TextBlock x:Name="AuthTitle" Text="Вход в аккаунт" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Логин" Margin="0,28,0,8" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="LoginBox" Style="{StaticResource InputBox}"/><TextBlock Text="Пароль" Margin="0,16,0,8" Foreground="{StaticResource MutedBrush}"/><PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}"/><TextBlock x:Name="AuthStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#E98C8C"/><Button x:Name="AuthActionButton" Content="ВОЙТИ" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Click="AuthActionButton_Click"/><Button x:Name="SwitchAuthButton" Content="Создать аккаунт" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="SwitchAuthButton_Click"/><TextBlock Text="Аккаунт хранится локально на этом ПК." Margin="0,18,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="MainView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"><TextBlock Text="☀" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="SOLARIS" FontSize="24" FontWeight="Bold"/><TextBlock Text="MINECRAFT UNIVERSE" FontSize="9" Foreground="#697285"/></StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="WelcomeText" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"/><Button Content="Выйти" Style="{StaticResource NavButton}" HorizontalAlignment="Right" Click="LogoutButton_Click"/></StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="315"/></Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,12"><TextBlock Text="МИРЫ" FontSize="12" FontWeight="SemiBold" Foreground="#747D8F"/><Border Background="#1B1531" CornerRadius="8" Padding="8,3" Margin="10,0,0,0"><TextBlock Text="2 РЕЖИМА" FontSize="9" Foreground="#B99AFF"/></Border></StackPanel>

                        <Border Background="#11151F" BorderBrush="#40326A" BorderThickness="1" CornerRadius="20" Padding="24" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="#F6C85F"><TextBlock Text="☀" Foreground="#17120A" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0"><TextBlock Text="SOLARIS VANILLA" FontSize="20" FontWeight="Bold"/><TextBlock Text="ОСНОВНОЙ РЕЖИМ" FontSize="9" Foreground="#8B7CA9" Margin="0,2,0,0"/></StackPanel></StackPanel>
                                    <TextBlock Text="Minecraft 26.2 • Survival" FontSize="13" Foreground="#A9B1C0" Margin="0,16,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0"><Ellipse Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center"/><TextBlock Text=" Сервер готов" Foreground="#86EFAC" FontSize="11"/><TextBlock Text="  •  25565" Foreground="#5E6676" FontSize="10" Margin="8,0,0,0"/></StackPanel>
                                    <TextBlock Text="solarisplay.millida.host:25565" FontSize="10" Foreground="#60697A" Margin="0,7,0,0"/>
                                </StackPanel>
                                <Button x:Name="VanillaPlayButton" Grid.Column="1" Content="ИГРАТЬ" Style="{StaticResource PrimaryButton}" Width="126" Height="50" VerticalAlignment="Center" Click="VanillaPlayButton_Click"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="#211C39"><TextBlock Text="⚙" Foreground="#B99AFF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0"><TextBlock Text="SOLARIS MODDED" FontSize="20" FontWeight="Bold"/><TextBlock Text="FORGE СБОРКА" FontSize="9" Foreground="#777F91" Margin="0,2,0,0"/></StackPanel></StackPanel>
                                    <TextBlock Text="Minecraft 1.20.1 • Forge 47.4.20" FontSize="13" Foreground="#A9B1C0" Margin="0,16,0,0"/><TextBlock Text="Модовая сборка Solaris" FontSize="10" Foreground="#60697A" Margin="0,7,0,0"/>
                                </StackPanel>
                                <Button x:Name="PlayButton" Grid.Column="1" Content="ИГРАТЬ" Style="{StaticResource SecondaryButton}" Width="126" Height="50" VerticalAlignment="Center" Click="PlayButton_Click"/>
                            </Grid>
                        </Border>

                        <Border Background="#0B0F17" BorderBrush="#1D2431" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,14,0,0">
                            <Grid><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Value="0"/><Grid Margin="0,9,0,0"><TextBlock x:Name="StatusText" Text="Готов к запуску." Foreground="#737C8D" FontSize="10"/><TextBlock x:Name="VersionText" Text="" HorizontalAlignment="Right" Foreground="#505866" FontSize="10"/></Grid></Grid>
                        </Border>

                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel><TextBlock Text="📰  НОВОСТИ SOLARIS" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Добро пожаловать в Solaris" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Новые приключения уже начинаются." TextWrapping="Wrap" FontSize="10" Foreground="#747D8F" Margin="0,5,0,0"/><Button Content="Подробнее" Style="{StaticResource NavButton}" HorizontalAlignment="Left" Margin="-10,7,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18"><StackPanel><TextBlock Text="⚡  БЫСТРЫЙ СТАТУС" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Клиент готов" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Vanilla 26.2  •  Modded 1.20.1" FontSize="10" Foreground="#747D8F" Margin="0,5,0,0"/><TextBlock Text="Запуск безопасен" FontSize="10" Foreground="#86EFAC" Margin="0,5,0,0"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ПРОФИЛЬ" FontSize="11" FontWeight="SemiBold" Foreground="#737C8D"/>
                                <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="66" Height="66" CornerRadius="33" Background="{StaticResource AccentBrush}" BorderBrush="#B89BFF" BorderThickness="2"><TextBlock Text="S" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="Игрок Solaris" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="● В сети" FontSize="10" Foreground="#86EFAC" Margin="0,5,0,0"/></StackPanel></Grid>
                                <TextBlock x:Name="ProfileText" Text="Версия клиента: Minecraft 1.20.1" Foreground="#727B8C" FontSize="10" Margin="0,13,0,0" TextWrapping="Wrap"/>
                                <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ОНЛАЙН" FontSize="9" Foreground="#60697A"/><TextBlock Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ИГРЫ" FontSize="9" Foreground="#60697A"/><TextBlock Text="0" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="LEVEL" FontSize="9" Foreground="#60697A"/><TextBlock Text="1" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="АВАТАР" FontSize="11" FontWeight="SemiBold" Foreground="#737C8D"/><TextBlock Text="Minecraft skin ↔ Solaris" FontSize="10" Foreground="#60697A" Margin="0,4,0,10"/><RadioButton Content="Голова скина" GroupName="Avatar" IsChecked="True" Style="{StaticResource AvatarRadio}" IsHitTestVisible="False"/></StackPanel></Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="НАСТРОЙКИ" FontSize="11" FontWeight="SemiBold" Foreground="#737C8D"/><TextBlock Text="Оперативная память" FontSize="11" Foreground="#AAB2C0" Margin="0,16,0,8"/><DockPanel><Slider x:Name="RamSlider" Minimum="2048" Maximum="4096" TickFrequency="512" IsSnapToTickEnabled="True" Value="3072" ValueChanged="RamSlider_ValueChanged"/><TextBlock x:Name="RamText" Text="3072 MB" Width="70" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10"/></DockPanel><TextBlock Text="Java определяется автоматически" FontSize="9" Foreground="#5E6676" Margin="0,8,0,0"/></StackPanel></Border>

                        <Border Background="#0C1018" BorderBrush="#1D2431" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,14,0,0"><StackPanel><Grid><TextBlock Text="🏆  ДОСТИЖЕНИЯ" FontSize="11" FontWeight="SemiBold" Foreground="#737C8D"/><TextBlock x:Name="AchievementsCount" Text="0 / 3" HorizontalAlignment="Right" FontSize="9" Foreground="#A78BFA"/></Grid><TextBlock x:Name="AchievementWelcome" Text="○  Добро пожаловать — аккаунт создан" FontSize="10" Foreground="#5E6676" Margin="0,11,0,0"/><TextBlock x:Name="AchievementFirstLaunch" Text="○  Первый запуск — запусти Minecraft" FontSize="10" Foreground="#5E6676" Margin="0,7,0,0"/><TextBlock x:Name="AchievementExplorer" Text="○  Исследователь — попробуй Vanilla и Modded" FontSize="10" Foreground="#5E6676" Margin="0,7,0,0"/></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="SOLARIS LAUNCHER • Minecraft 26.2 / 1.20.1 Forge" FontSize="9" Foreground="#4D5563"/>
        </Grid>
    </Grid>
</Window>