<Window x:Class="SolarisLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SolarisLauncher" Width="900" Height="560"
 WindowStartupLocation="CenterScreen" Background="#10131A">
 <Grid Margin="28">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel>
   <TextBlock Text="SOLARIS" FontSize="34" FontWeight="Bold" Foreground="White"/>
   <TextBlock Text="Launcher • Minecraft 1.20.1 • Forge 47.4.20" FontSize="14" Foreground="#AAB3C2"/>
  </StackPanel>

  <Border Grid.Row="1" Margin="0,30,0,20" CornerRadius="18" Background="#171C26" Padding="28">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="280"/>
    </Grid.ColumnDefinitions>

    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="Добро пожаловать" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
     <TextBlock Text="Solaris сам установит Forge и загрузит актуальную сборку с GitHub."
                Margin="0,8,0,24" Foreground="#AAB3C2" FontSize="15" TextWrapping="Wrap"/>
     <TextBlock Text="Ник" Foreground="#AAB3C2"/>
     <TextBox x:Name="NickBox" Width="330" Height="38" HorizontalAlignment="Left"
              Margin="0,6,0,18" Padding="10" FontSize="15"/>
     <Button x:Name="PlayButton" Content="ИГРАТЬ" Width="220" Height="52"
             HorizontalAlignment="Left" Click="PlayButton_Click"
             FontSize="17" FontWeight="Bold"/>
    </StackPanel>

    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="Сборка GitHub" Foreground="#AAB3C2"/>
     <TextBlock x:Name="VersionText" Text="—" Foreground="White"
                FontSize="25" FontWeight="Bold" Margin="0,3,0,20"/>
     <TextBlock Text="Статус" Foreground="#AAB3C2"/>
     <TextBlock x:Name="StatusText" Text="Готов к запуску"
                Foreground="#DDE3EC" FontSize="16" Margin="0,3,0,20" TextWrapping="Wrap"/>
     <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0"/>
    </StackPanel>
   </Grid>
  </Border>

  <TextBlock Grid.Row="2" Text="SolarisLauncher 2.0 • GitHub updater"
             Foreground="#6F7888" HorizontalAlignment="Right"/>
 </Grid>
</Window>
