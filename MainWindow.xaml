<Window x:Class="SolarisLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Solaris Launcher" Width="1320" Height="850" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#090716" Foreground="#F5F7FA" FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/SolarisOfficialLogo.png">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#E00F0C1F"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#21182E"/>
        <SolidColorBrush x:Key="Panel3Brush" Color="#0D0B19"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3D3453"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#BAB0D0"/>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#8D35FC" Offset="0"/><GradientStop Color="#D43CCF" Offset="0.65"/><GradientStop Color="#FF9D3F" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#A358FF" Offset="0"/><GradientStop Color="#FA59BD" Offset="0.65"/><GradientStop Color="#FFBB54" Offset="1"/></LinearGradientBrush>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/><Setter Property="Padding" Value="20,0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="{StaticResource Panel2Brush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#AAB3C2"/><Setter Property="Padding" Value="10,7"/></Style>
        <!-- Compact predictable navigation: every tab is a button, including Profile. -->
        <Style x:Key="MinimalTopNav" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="#D7D1E3"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#0C111A"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#0C111A"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="AvatarRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Width="122" Height="116" Background="#121722" BorderBrush="#252B38" BorderThickness="1" CornerRadius="14" Padding="10"><StackPanel HorizontalAlignment="Center"><Border Width="54" Height="54" CornerRadius="27" Background="#8B5CF6"><TextBlock Text="S" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#A078FF"/><Setter TargetName="Card" Property="Background" Value="#1A1730"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#100D20" BorderBrush="#392046" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/SolarisOfficialLogo.png" Width="25" Height="25" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Solaris Launcher" VerticalAlignment="Center" FontSize="12" Margin="9,0,0,0" Foreground="#F0E8FC"/><TextBlock x:Name="NeonBuildTag" Text="  •  NEON 2.2.10" VerticalAlignment="Center" FontSize="10" Foreground="#9D86AE"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="─" Width="46" Height="40" FontSize="14" Background="Transparent" Foreground="#EADFF0" BorderThickness="0" Cursor="Hand" Click="TitleBarMinimize_Click"/>
                    <Button Content="□" Width="46" Height="40" FontSize="16" Background="Transparent" Foreground="#EADFF0" BorderThickness="0" Cursor="Hand" Click="TitleBarMaximize_Click"/>
                    <Button Content="✕" Width="46" Height="40" FontSize="14" Background="#1A1027" Foreground="#EADFF0" BorderThickness="0" Cursor="Hand" Click="TitleBarClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="12">
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#100B25" Offset="0"/><GradientStop Color="#090715" Offset="0.60"/><GradientStop Color="#190D22" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Grid x:Name="AuthView">
            <Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="LoginBackdrop" Grid.RowSpan="2" CornerRadius="20" ClipToBounds="True" BorderBrush="#C445AE" BorderThickness="1" CacheMode="BitmapCache">
                <Border.Background><ImageBrush ImageSource="pack://application:,,,/Assets/SolarisEmber.bmp" Stretch="UniformToFill"/></Border.Background>
            </Border>

            <Border Grid.RowSpan="2" CornerRadius="20" IsHitTestVisible="False">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5"><GradientStop Color="#170A0520" Offset="0"/><GradientStop Color="#47090C1E" Offset="0.56"/><GradientStop Color="#8F090719" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
            <!-- Original Solaris artwork retained behind the minimal centered layout. -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/SolarisOfficialLogo.png"
                           Width="66" Height="66" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="SOLARIS" FontSize="55" FontWeight="ExtraBold"
                               VerticalAlignment="Center" Margin="14,0,0,0" Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFB65B" BlurRadius="14" ShadowDepth="0" Opacity="0.48"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="БОЛЬШЕ ЧЕМ MINECRAFT" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0"
                           TextAlignment="Center" Foreground="#FFE4C3"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="10,0,10,10">
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,12" Padding="24" CornerRadius="18" BorderThickness="1.5">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F316102A" Offset="0"/><GradientStop Color="#F40B0A1E" Offset="0.7"/><GradientStop Color="#F5211021" Offset="1"/></LinearGradientBrush></Border.Background>
                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#AF39FD" Offset="0"/><GradientStop Color="#703D80" Offset="0.45"/><GradientStop Color="#FF883C" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
                <StackPanel>
                    <TextBlock x:Name="AuthTitle" Text="Вход в аккаунт" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                        <Button x:Name="LocalAuthModeButton" Content="Локальный" Style="{StaticResource SecondaryButton}" Width="120" Height="32" FontSize="11"
                                Click="LocalAuthMode_Click"/>
                        <Button x:Name="CloudAuthModeButton" Content="☀  SOLARIS ID" Style="{StaticResource SecondaryButton}" Width="150"
                                Height="32" FontSize="11" Margin="10,0,0,0" Click="CloudAuthMode_Click"/>
                    </StackPanel>
                    <TextBlock Text="Войди, чтобы продолжить игру" Foreground="#C4B6D5" FontSize="12" Margin="0,6,0,11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AuthLoginLabel" Text="Логин" Foreground="#D9D0E6" FontSize="12" Margin="0,8,0,7"/>
                    <TextBox x:Name="LoginBox" Style="{StaticResource InputBox}"/>
                    <StackPanel x:Name="CloudRegisterNicknamePanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Игровой ник Solaris ID" Foreground="#D9D0E6" FontSize="12" Margin="0,0,0,7"/>
                        <TextBox x:Name="CloudRegisterNickname" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                    <TextBlock Text="Пароль" Foreground="#D9D0E6" FontSize="12" Margin="0,20,0,7"/>
                    <Grid Height="46">
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}" Padding="13,0,50,0"
                                     GotKeyboardFocus="PasswordField_Focus" PreviewKeyUp="PasswordField_KeyUp" PreviewKeyDown="PasswordField_KeyDown"/>
                        <TextBox x:Name="PasswordVisibleText" Style="{StaticResource InputBox}" Padding="13,0,50,0"
                                 Visibility="Collapsed" GotKeyboardFocus="PasswordField_Focus"
                                 PreviewKeyUp="PasswordField_KeyUp" PreviewKeyDown="PasswordField_KeyDown"/>
                        <Button x:Name="PasswordRevealButton" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Показать пароль"
                                AutomationProperties.Name="Показать пароль" Click="PasswordReveal_Click">
                            <Grid Width="32" Height="32">
                                <Path x:Name="PasswordEyeClosed" Stroke="#FFCA31" StrokeThickness="2.2"
                                      Data="M 3,17 Q 16,10 29,17 M 8,11 L 6,7 M 16,11 L 16,6 M 24,11 L 27,7"/>
                                <Grid x:Name="PasswordEyeOpen" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform ScaleY="0.15"/></Grid.RenderTransform>
                                    <Path Stroke="#FFDD62" StrokeThickness="2.1" Data="M 2,16 Q 16,1 30,16 Q 16,31 2,16 Z"/>
                                    <Image Source="pack://application:,,,/Assets/SolarisOfficialLogo.png"
                                           Height="17" Width="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="CloudResetCodePanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Код восстановления из письма" FontSize="12"
                                   Foreground="#D9D0E6" Margin="0,0,0,6"/>
                        <TextBox x:Name="CloudResetCodeBox" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                    <TextBlock x:Name="CapsLockWarning" Text="⚠ Включён Caps Lock" FontSize="10"
                               Foreground="#FFCB6B" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <StackPanel x:Name="ConfirmPasswordPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Повторите пароль" Foreground="#D9D0E6" FontSize="12" Margin="0,0,0,7"/>
                        <Grid Height="46">
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource PasswordBoxStyle}" Padding="13,0,50,0"
                                         GotKeyboardFocus="PasswordField_Focus" PreviewKeyUp="PasswordField_KeyUp"
                                         PreviewKeyDown="PasswordField_KeyDown"/>
                            <TextBox x:Name="ConfirmPasswordVisibleText" Style="{StaticResource InputBox}" Padding="13,0,50,0"
                                     Visibility="Collapsed" GotKeyboardFocus="PasswordField_Focus"
                                     PreviewKeyUp="PasswordField_KeyUp" PreviewKeyDown="PasswordField_KeyDown"/>
                            <Button x:Name="ConfirmPasswordRevealButton" Width="44" Height="44" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Показать подтверждение пароля" AutomationProperties.Name="Показать подтверждение пароля"
                                    Click="ConfirmPasswordReveal_Click">
                                <Grid Width="32" Height="32">
                                    <Path x:Name="ConfirmEyeClosed" Stroke="#FFCA31" StrokeThickness="2.2"
                                          Data="M 3,17 Q 16,10 29,17 M 8,11 L 6,7 M 16,11 L 16,6 M 24,11 L 27,7"/>
                                    <Grid x:Name="ConfirmEyeOpen" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform><ScaleTransform ScaleY="0.15"/></Grid.RenderTransform>
                                        <Path Stroke="#FFDD62" StrokeThickness="2.1" Data="M 2,16 Q 16,1 30,16 Q 16,31 2,16 Z"/>
                                        <Image Source="pack://application:,,,/Assets/SolarisOfficialLogo.png"
                                               Height="17" Width="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <CheckBox x:Name="RememberMeCheck" Content="Запомнить меня" IsChecked="False" Foreground="#DCD1EC" FontSize="12" Margin="2,20,0,0" Cursor="Hand"/>
                    <TextBlock x:Name="AuthStatus" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFACB3" FontSize="11"/>
                    <Button x:Name="AuthActionButton" Content="ВОЙТИ  ›" Style="{StaticResource PrimaryButton}" Height="46" FontSize="15" Margin="0,13,0,0" Click="AuthActionButton_Click"/>
                    <Button x:Name="SwitchAuthButton" Content="Создать аккаунт" Style="{StaticResource SecondaryButton}" Height="34" FontSize="11" Margin="0,8,0,0" Click="SwitchAuthButton_Click"/>
                    <Button x:Name="CloudForgotPasswordButton" Content="Забыли пароль Solaris ID?" Style="{StaticResource NavButton}"
                            Visibility="Collapsed" HorizontalAlignment="Center" Height="32"
                            FontSize="11" Margin="0,8,0,0" Click="CloudForgotPassword_Click"/>
                    <Border BorderBrush="#443250" BorderThickness="0,1,0,0" Margin="0,29,0,0"/>
                    <TextBlock x:Name="AuthStorageExplanation" Text="Аккаунт хранится локально на этом ПК."
                               Margin="0,18,0,0" HorizontalAlignment="Center" Foreground="#92839E"
                               FontSize="10" TextWrapping="Wrap" TextAlignment="Center"/>
                    <!-- Artwork import is still available in Settings; keep login focused. -->
                    <TextBlock x:Name="ArtworkDiagnosticText" Text="" Visibility="Collapsed" FontSize="10" Foreground="#E6B894" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </Grid>


        <!-- The approved no-character cosmic UI. Fixed footer and two equal columns; never scroll. -->
        <Grid x:Name="MainView" Visibility="Collapsed" ClipToBounds="True" Background="#0A0619">
          <Grid.RowDefinitions>
            <RowDefinition Height="1.5*" MinHeight="125"/>
            <RowDefinition Height="4*" MinHeight="290"/>
            <RowDefinition Height="88"/>
            <RowDefinition Height="64"/>
          </Grid.RowDefinitions>
          <!-- Existing approved world images replace this brush in NeonArtwork.cs -->
          <Border Grid.RowSpan="4" Background="#36060819" IsHitTestVisible="False"/>
          <Grid Grid.Row="0" Margin="16,8,16,4">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
            <!-- Two painted accretion discs: decorative Borders, not status Ellipses. -->
            <Border Width="120" Height="120" CornerRadius="70" HorizontalAlignment="Center" Margin="-500,0,0,0"
                    BorderBrush="#4184FF" BorderThickness="6" IsHitTestVisible="False">
              <Border.Background><RadialGradientBrush>
                <GradientStop Color="#00020B" Offset="0"/><GradientStop Color="#00020B" Offset="0.52"/>
                <GradientStop Color="#0056D8" Offset="0.79"/><GradientStop Color="#090920" Offset="1"/>
              </RadialGradientBrush></Border.Background>
              <Border.Effect><DropShadowEffect Color="#009DFF" BlurRadius="19" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
            </Border>
            <Border Width="120" Height="120" CornerRadius="70" HorizontalAlignment="Center" Margin="500,0,0,0"
                    BorderBrush="#FF8A1D" BorderThickness="6" IsHitTestVisible="False">
              <Border.Background><RadialGradientBrush>
                <GradientStop Color="#040205" Offset="0"/><GradientStop Color="#040205" Offset="0.52"/>
                <GradientStop Color="#CA4807" Offset="0.79"/><GradientStop Color="#270709" Offset="1"/>
              </RadialGradientBrush></Border.Background>
              <Border.Effect><DropShadowEffect Color="#FF6800" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
            </Border>
            <TextBlock Text="SOLARIS" FontSize="60" FontWeight="Black" HorizontalAlignment="Center"
                       VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#FF962C" Offset="0"/><GradientStop Color="#FFF7D8" Offset="0.45"/>
                <GradientStop Color="#78C9FF" Offset="0.76"/><GradientStop Color="#FFAF4A" Offset="1"/>
              </LinearGradientBrush></TextBlock.Foreground>
              <TextBlock.Effect><DropShadowEffect Color="#EA741B" BlurRadius="13" ShadowDepth="0" Opacity="0.85"/></TextBlock.Effect>
            </TextBlock>
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
              <TextBlock Text="S O L A R I S" FontSize="11" Foreground="#FFF0D9" FontWeight="Bold"/>
              <TextBlock Text="БОЛЬШЕ" FontSize="11" Foreground="White" Margin="0,8,0,0"/>
              <TextBlock Text="ЧЕМ MINECRAFT" FontSize="11" Foreground="White" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
              <Border Background="#EA100E22" BorderBrush="#8D679D" BorderThickness="1" CornerRadius="10" Padding="7">
                <StackPanel Orientation="Horizontal">
                  <Border Width="38" Height="38" CornerRadius="7" Background="#28203B" Cursor="Hand"
                          MouseLeftButtonUp="ProfileAvatar_Click">
                    <Grid ClipToBounds="True">
                      <Grid x:Name="ProfileAvatarFallback">
                        <TextBlock Text="◈" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="22"/>
                      </Grid>
                      <Image x:Name="ProfileAvatarImage" Visibility="Collapsed" Stretch="Fill"
                             RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Grid>
                  </Border>
                  <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="ProfileTopButton" Content="Профиль" Style="{StaticResource NavButton}"
                            FontSize="11" FontWeight="SemiBold" Height="23" Padding="0"
                            HorizontalAlignment="Left" Click="ProfileNav_Click"/>
                    <TextBlock x:Name="WelcomeText" FontSize="10" Foreground="#9BFBBE"
                               TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                  </StackPanel>
                  <Button Content="↪" Width="29" Height="35" Background="Transparent" Foreground="White"
                          BorderThickness="0" Click="LogoutButton_Click" ToolTip="Выйти из аккаунта"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Grid.Row="1" Background="#E90A0C1C" HorizontalAlignment="Center"
                    VerticalAlignment="Center" CornerRadius="10" Padding="4"
                    BorderBrush="#514565" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Border Background="#BD661D" CornerRadius="8" Padding="16,9">
                  <TextBlock Text="◎  Миры" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                </Border>
                <Button Content="⚙  Настройки" Style="{StaticResource MinimalTopNav}" Click="SettingsNav_Click"/>
                <Button Content="▤  Новости" Style="{StaticResource MinimalTopNav}" Click="NewsNav_Click"/>
                <Button Content="♧  Сообщество" Style="{StaticResource MinimalTopNav}"
                        Click="NewsTelegram_Click" ToolTip="Сообщество Solaris"/>
                <Button Content="ⓘ  О проекте" Style="{StaticResource MinimalTopNav}" Click="AboutNav_Click"/>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="1" Margin="18,0,18,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="VanillaCard" Grid.Column="0" Background="#100812" BorderBrush="#FF9B36"
                    BorderThickness="2" CornerRadius="16" ClipToBounds="True"
                    MouseEnter="VanillaCard_MouseEnter" MouseLeave="VanillaCard_MouseLeave">
              <Grid ClipToBounds="True">
                <!-- The soft backdrop fills the tall tile; only this intentionally cropped layer is blurred. -->
                <Image x:Name="VanillaArtwork" Source="pack://application:,,,/Assets/SolarisVanillaCard.png"
                       Stretch="UniformToFill" Opacity="0.78" CacheMode="BitmapCache" IsHitTestVisible="False">
                  <Image.Effect><BlurEffect Radius="9"/></Image.Effect>
                </Image>
                <!-- Original 3:1 banner: fit its entire width above the details. Never crop the approved art. -->
                <Image x:Name="VanillaArtworkSharp" Source="pack://application:,,,/Assets/SolarisVanillaCard.png"
                       Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                       Opacity="0" CacheMode="BitmapCache" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
                  <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="White" Offset="0"/>
                      <GradientStop Color="White" Offset="0.75"/>
                      <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                  </Image.OpacityMask>
                </Image>
                <Border IsHitTestVisible="False">
                  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#770E0715" Offset="0"/><GradientStop Color="#300E0715" Offset="0.42"/>
                    <GradientStop Color="#D80B0715" Offset="0.87"/><GradientStop Color="#ED0C0613" Offset="1"/>
                  </LinearGradientBrush></Border.Background>
                </Border>
                <Grid Margin="13,13,13,12">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="53"/><RowDefinition Height="57"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/SolarisOfficialLogo.png" Height="49" Width="49"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                      <TextBlock Text="SOLARIS VANILLA" FontWeight="ExtraBold" FontSize="21"/>
                      <TextBlock Text="ОСНОВНОЙ РЕЖИМ" FontSize="10" Foreground="#FFE4B3"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="1,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                      <Ellipse Width="8" Height="8" Fill="#F87171" VerticalAlignment="Center"/>
                      <TextBlock Text=" Сервер офлайн" FontSize="11" Foreground="#FCA5A5"/>
                    </StackPanel>
                    <TextBlock x:Name="VanillaVersionText" Text="Minecraft 26.2 • Survival"
                               FontSize="13" Foreground="#FFF2E7"/>
                    <TextBlock Text="Классическое выживание, экономика, кланы"
                               FontSize="11" Foreground="#FFFFFF" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="и большое сообщество." FontSize="11" Foreground="#ECE3E8"/>
                    <TextBlock x:Name="VanillaInstallStateText" Text="Проверяем клиент..." FontSize="10"
                               Foreground="#FFE0A0" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="VanillaHours" Visibility="Collapsed" FontSize="10"/>
                  </StackPanel>
