<Window x:Class="SolarisLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Solaris Launcher" Width="1320" Height="850" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#090716" Foreground="#F5F7FA" FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/SolarisOfficialLogo.png">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#E00F0C1F"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#281933"/>
        <SolidColorBrush x:Key="Panel3Brush" Color="#0D0919"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#563C6E"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#BAB0D0"/>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#8D35FC" Offset="0"/><GradientStop Color="#D43CCF" Offset="0.65"/><GradientStop Color="#FF9D3F" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#A358FF" Offset="0"/><GradientStop Color="#FA59BD" Offset="0.65"/><GradientStop Color="#FFBB54" Offset="1"/></LinearGradientBrush>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/><Setter Property="Padding" Value="20,0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="{StaticResource Panel2Brush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#AAB3C2"/><Setter Property="Padding" Value="10,7"/></Style>
        <Style x:Key="InputBox" TargetType="TextBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#0C111A"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#0C111A"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="AvatarRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Width="122" Height="116" Background="#121722" BorderBrush="#252B38" BorderThickness="1" CornerRadius="14" Padding="10"><StackPanel HorizontalAlignment="Center"><Border Width="54" Height="54" CornerRadius="27" Background="#8B5CF6"><TextBlock Text="S" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#A078FF"/><Setter TargetName="Card" Property="Background" Value="#1A1730"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#100D20" BorderBrush="#392046" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/SolarisOfficialLogo.png" Width="25" Height="25" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Solaris Launcher" VerticalAlignment="Center" FontSize="12" Margin="9,0,0,0" Foreground="#F0E8FC"/><TextBlock x:Name="NeonBuildTag" Text="  •  NEON 2.2.10" VerticalAlignment="Center" FontSize="10" Foreground="#9D86AE"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="─" Width="46" Height="40" FontSize="14" Background="Transparent" Foreground="#EADFF0" BorderThickness="0" Cursor="Hand" Click="TitleBarMinimize_Click"/>
                    <Button Content="□" Width="46" Height="40" FontSize="16" Background="Transparent" Foreground="#EADFF0" BorderThickness="0" Cursor="Hand" Click="TitleBarMaximize_Click"/>
                    <Button Content="✕" Width="46" Height="40" FontSize="14" Background="#1A1027" Foreground="#EADFF0" BorderThickness="0" Cursor="Hand" Click="TitleBarClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="12">
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#100B25" Offset="0"/><GradientStop Color="#090715" Offset="0.60"/><GradientStop Color="#190D22" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Grid x:Name="AuthView">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.22*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
            <Border x:Name="LoginBackdrop" Grid.ColumnSpan="2" CornerRadius="20" ClipToBounds="True" BorderBrush="#C445AE" BorderThickness="1" CacheMode="BitmapCache">
                <Border.Background><ImageBrush ImageSource="pack://application:,,,/Assets/SolarisEmber.bmp" Stretch="UniformToFill"/></Border.Background>
            </Border>

            <Border Grid.ColumnSpan="2" CornerRadius="20" IsHitTestVisible="False">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5"><GradientStop Color="#290A0520" Offset="0"/><GradientStop Color="#87120925" Offset="0.56"/><GradientStop Color="#B1090719" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
            <Border Grid.Column="0" Background="#070B0519" IsHitTestVisible="False" CornerRadius="20"/>
            <!-- Login hero branding: intentionally above the former bottom-left
                 position, balanced against the account form on the right. -->
            <Grid Grid.Column="0" Margin="48,24,18,30" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.80*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="1" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/SolarisOfficialLogo.png"
                               Width="70" Height="70" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="SOLARIS" FontSize="56" FontWeight="ExtraBold"
                                   VerticalAlignment="Center" Margin="17,0,0,0" Foreground="#FFFFFFFF">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFE5B5" BlurRadius="9"
                                                  ShadowDepth="0" Opacity="0.22"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Открой свой мир возможностей."
                               Margin="87,9,0,0" FontSize="18" FontWeight="Light"
                               Foreground="#FFE8C4" TextWrapping="Wrap" MaxWidth="440">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFD58A" BlurRadius="12"
                                              ShadowDepth="0" Opacity="0.58"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Border Grid.Column="1" Margin="26,50,38,50" VerticalAlignment="Center" Padding="38" CornerRadius="22" BorderThickness="1.5">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F316102A" Offset="0"/><GradientStop Color="#F40B0A1E" Offset="0.7"/><GradientStop Color="#F5211021" Offset="1"/></LinearGradientBrush></Border.Background>
                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#AF39FD" Offset="0"/><GradientStop Color="#703D80" Offset="0.45"/><GradientStop Color="#FF883C" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
                <StackPanel>
                    <TextBlock x:Name="AuthTitle" Text="Вход в аккаунт" FontSize="29" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                        <Button x:Name="LocalAuthModeButton" Content="Локальный" Style="{StaticResource SecondaryButton}" Width="120" Height="32" FontSize="11"
                                Click="LocalAuthMode_Click"/>
                        <Button x:Name="CloudAuthModeButton" Content="☀  SOLARIS ID" Style="{StaticResource SecondaryButton}" Width="150"
                                Height="32" FontSize="11" Margin="10,0,0,0" Click="CloudAuthMode_Click"/>
                    </StackPanel>
                    <TextBlock Text="Добро пожаловать в Solaris" Foreground="#C4B6D5" FontSize="13" Margin="0,6,0,20"/>
                    <TextBlock x:Name="AuthLoginLabel" Text="Логин" Foreground="#D9D0E6" FontSize="12" Margin="0,8,0,7"/>
                    <TextBox x:Name="LoginBox" Style="{StaticResource InputBox}"/>
                    <StackPanel x:Name="CloudRegisterNicknamePanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Игровой ник Solaris ID" Foreground="#D9D0E6" FontSize="12" Margin="0,0,0,7"/>
                        <TextBox x:Name="CloudRegisterNickname" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                    <TextBlock Text="Пароль" Foreground="#D9D0E6" FontSize="12" Margin="0,20,0,7"/>
                    <Grid Height="46">
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}" Padding="13,0,50,0"
                                     GotKeyboardFocus="PasswordField_Focus" PreviewKeyUp="PasswordField_KeyUp" PreviewKeyDown="PasswordField_KeyDown"/>
                        <TextBox x:Name="PasswordVisibleText" Style="{StaticResource InputBox}" Padding="13,0,50,0"
                                 Visibility="Collapsed" GotKeyboardFocus="PasswordField_Focus"
                                 PreviewKeyUp="PasswordField_KeyUp" PreviewKeyDown="PasswordField_KeyDown"/>
                        <Button x:Name="PasswordRevealButton" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Показать пароль"
                                AutomationProperties.Name="Показать пароль" Click="PasswordReveal_Click">
                            <Grid Width="32" Height="32">
                                <Path x:Name="PasswordEyeClosed" Stroke="#FFCA31" StrokeThickness="2.2"
                                      Data="M 3,17 Q 16,10 29,17 M 8,11 L 6,7 M 16,11 L 16,6 M 24,11 L 27,7"/>
                                <Grid x:Name="PasswordEyeOpen" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform ScaleY="0.15"/></Grid.RenderTransform>
                                    <Path Stroke="#FFDD62" StrokeThickness="2.1" Data="M 2,16 Q 16,1 30,16 Q 16,31 2,16 Z"/>
                                    <Image Source="pack://application:,,,/Assets/SolarisOfficialLogo.png"
                                           Height="17" Width="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="CloudResetCodePanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Код восстановления из письма" FontSize="12"
                                   Foreground="#D9D0E6" Margin="0,0,0,6"/>
                        <TextBox x:Name="CloudResetCodeBox" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                    <TextBlock x:Name="CapsLockWarning" Text="⚠ Включён Caps Lock" FontSize="10"
                               Foreground="#FFCB6B" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <StackPanel x:Name="ConfirmPasswordPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Повторите пароль" Foreground="#D9D0E6" FontSize="12" Margin="0,0,0,7"/>
                        <Grid Height="46">
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource PasswordBoxStyle}" Padding="13,0,50,0"
                                         GotKeyboardFocus="PasswordField_Focus" PreviewKeyUp="PasswordField_KeyUp"
                                         PreviewKeyDown="PasswordField_KeyDown"/>
                            <TextBox x:Name="ConfirmPasswordVisibleText" Style="{StaticResource InputBox}" Padding="13,0,50,0"
                                     Visibility="Collapsed" GotKeyboardFocus="PasswordField_Focus"
                                     PreviewKeyUp="PasswordField_KeyUp" PreviewKeyDown="PasswordField_KeyDown"/>
                            <Button x:Name="ConfirmPasswordRevealButton" Width="44" Height="44" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Показать подтверждение пароля" AutomationProperties.Name="Показать подтверждение пароля"
                                    Click="ConfirmPasswordReveal_Click">
                                <Grid Width="32" Height="32">
                                    <Path x:Name="ConfirmEyeClosed" Stroke="#FFCA31" StrokeThickness="2.2"
                                          Data="M 3,17 Q 16,10 29,17 M 8,11 L 6,7 M 16,11 L 16,6 M 24,11 L 27,7"/>
                                    <Grid x:Name="ConfirmEyeOpen" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform><ScaleTransform ScaleY="0.15"/></Grid.RenderTransform>
                                        <Path Stroke="#FFDD62" StrokeThickness="2.1" Data="M 2,16 Q 16,1 30,16 Q 16,31 2,16 Z"/>
                                        <Image Source="pack://application:,,,/Assets/SolarisOfficialLogo.png"
                                               Height="17" Width="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <CheckBox x:Name="RememberMeCheck" Content="Запомнить меня" IsChecked="False" Foreground="#DCD1EC" FontSize="12" Margin="2,20,0,0" Cursor="Hand"/>
                    <TextBlock x:Name="AuthStatus" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFACB3" FontSize="11"/>
                    <Button x:Name="AuthActionButton" Content="ВОЙТИ  ›" Style="{StaticResource PrimaryButton}" Height="52" FontSize="15" Margin="0,22,0,0" Click="AuthActionButton_Click"/>
                    <Button x:Name="SwitchAuthButton" Content="Создать аккаунт" Style="{StaticResource SecondaryButton}" Height="48" Margin="0,12,0,0" Click="SwitchAuthButton_Click"/>
                    <Button x:Name="CloudForgotPasswordButton" Content="Забыли пароль Solaris ID?" Style="{StaticResource NavButton}"
                            Visibility="Collapsed" HorizontalAlignment="Center" Height="32"
                            FontSize="11" Margin="0,8,0,0" Click="CloudForgotPassword_Click"/>
                    <Border BorderBrush="#443250" BorderThickness="0,1,0,0" Margin="0,29,0,0"/>
                    <TextBlock x:Name="AuthStorageExplanation" Text="Аккаунт хранится локально на этом ПК."
                               Margin="0,18,0,0" HorizontalAlignment="Center" Foreground="#92839E"
                               FontSize="10" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button Content="🎨  Выбрать оформление (ZIP)" Style="{StaticResource SecondaryButton}" Height="32" FontSize="11" Margin="0,15,0,0" Click="ImportNeonArtwork_Click"/>
                    <TextBlock x:Name="ArtworkDiagnosticText" Text="Проверка оформления..." FontSize="10" Foreground="#E6B894" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="MainView" Visibility="Collapsed"><Grid.Background><ImageBrush ImageSource="pack://application:,,,/Assets/SolarisEmber.bmp" Opacity="0.19" Stretch="UniformToFill"/></Grid.Background>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="pack://application:,,,/Assets/SolarisOfficialLogo.png" Width="70" Height="70" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel VerticalAlignment="Center" Margin="13,0,0,0"><TextBlock Text="SOLARIS" FontSize="32" FontWeight="ExtraBold"/><TextBlock Text="Открой свой мир возможностей." Foreground="#FFE8C4"
                                           FontSize="11" FontWeight="Light" Margin="0,2,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#FFD58A" BlurRadius="12" ShadowDepth="0" Opacity="0.62"/>
                                    </TextBlock.Effect>
                                </TextBlock></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Padding="23,11" CornerRadius="12" Background="#512299" BorderBrush="#AA45F8" BorderThickness="1"><TextBlock Text="⬡  Миры" FontSize="14" FontWeight="SemiBold" Foreground="White"/></Border>
                    <Button Content="⚙  Настройки" VerticalAlignment="Center" Margin="25,0,0,0" Style="{StaticResource NavButton}" Foreground="#FFE09A" FontSize="13" Click="SettingsNav_Click"/>
                    <TextBlock Text="▤  Новости" VerticalAlignment="Center" Margin="25,0,0,0" Foreground="#C3B7D0" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="WelcomeText" HorizontalAlignment="Right" FontSize="15" FontWeight="Bold"/><Button Content="Выйти" Style="{StaticResource NavButton}" HorizontalAlignment="Right" Click="LogoutButton_Click"/></StackPanel>
            </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,12"><TextBlock Text="МИРЫ" FontSize="12" FontWeight="SemiBold" Foreground="#D1B0EB"/><Border Background="#1B1531" CornerRadius="8" Padding="8,3" Margin="10,0,0,0"><TextBlock Text="2 РЕЖИМА" FontSize="10" Foreground="#D8AEFF"/></Border></StackPanel>

                        <Border x:Name="VanillaCard" Background="#161023" BorderBrush="#FF954F" BorderThickness="1.5" CornerRadius="18" Margin="0,0,0,14" MouseEnter="VanillaCard_MouseEnter" MouseLeave="VanillaCard_MouseLeave">
                            <Grid Height="222" ClipToBounds="True">
                                <Border CornerRadius="18" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#351742" Offset="0"/><GradientStop Color="#934177" Offset="0.52"/><GradientStop Color="#FF943F" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <Image x:Name="VanillaArtwork" Source="pack://application:,,,/Assets/SolarisEmber.bmp" Stretch="UniformToFill" Opacity="0.94" IsHitTestVisible="False" CacheMode="BitmapCache" RenderOptions.BitmapScalingMode="Fant"/>
                                <Image x:Name="VanillaArtworkSharp" Source="pack://application:,,,/Assets/SolarisEmber.bmp" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" CacheMode="BitmapCache"/>
                                <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#D70C091A" Offset="0"/><GradientStop Color="#57110E23" Offset="0.49"/><GradientStop Color="#25130621" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <Grid Margin="23,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/SolarisOfficialLogo.png" Width="42" Height="42" Stretch="Uniform"/>
                                            <StackPanel Margin="11,0,0,0"><TextBlock Text="SOLARIS VANILLA" FontSize="22" FontWeight="Bold"/><TextBlock Text="ОСНОВНОЙ РЕЖИМ" FontSize="10" Foreground="#D3BDD8"/></StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Minecraft 26.2 • Survival" FontSize="13" Margin="0,13,0,0" Foreground="#F0E4EF"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0"><Ellipse Width="8" Height="8" Fill="#3DFFA3" VerticalAlignment="Center"/><TextBlock Text=" Сервер готов" Foreground="#64FFAD" FontSize="11"/></StackPanel>
                                        <TextBlock Text="solarisplay.millida.host:25565" Foreground="#B5A1BC" FontSize="10" Margin="0,5,0,0"/>
                                        <TextBlock x:Name="VanillaHours" Text="В игре: 0 ч 0 мин" Foreground="#FFE2A1" FontSize="10" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="VanillaPlayButton" Grid.Column="1" Content="▶  ИГРАТЬ" Style="{StaticResource PrimaryButton}" Width="184" Height="58" VerticalAlignment="Center" Click="VanillaPlayButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

        <Border x:Name="ModdedCard" Background="#150D26" BorderBrush="#A445E5" BorderThickness="1.5" CornerRadius="18" MouseEnter="ModdedCard_MouseEnter" MouseLeave="ModdedCard_MouseLeave">
                            <Grid Height="204" ClipToBounds="True">
                                <Border CornerRadius="18" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#210B31" Offset="0"/><GradientStop Color="#58258E" Offset="0.6"/><GradientStop Color="#871DA0" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <Image x:Name="ModdedArtwork" Source="pack://application:,,,/Assets/SolarisEmber.bmp" Stretch="UniformToFill" Opacity="0.90" IsHitTestVisible="False" CacheMode="BitmapCache" RenderOptions.BitmapScalingMode="Fant"/>
                                <Image x:Name="ModdedArtworkSharp" Source="pack://application:,,,/Assets/SolarisEmber.bmp" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" CacheMode="BitmapCache"/>
                                <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#DA0D0620" Offset="0"/><GradientStop Color="#642C0B4B" Offset="0.5"/><GradientStop Color="#3C200437" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <Grid Margin="23,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" CornerRadius="11" Background="#5720AD"><TextBlock Text="⚙" Foreground="#F4D1FF" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Margin="11,0,0,0"><TextBlock Text="SOLARIS MODDED" FontSize="22" FontWeight="Bold"/><TextBlock Text="FORGE СБОРКА" FontSize="10" Foreground="#C3A5DE"/></StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Minecraft 1.20.1 • Forge 47.4.20" FontSize="13" Foreground="#E7D9F1" Margin="0,14,0,0"/>
                                        <TextBlock Text="Модовая сборка Solaris" FontSize="10" Foreground="#BB9BD0" Margin="0,9,0,0"/>
                                        <TextBlock x:Name="ModdedHours" Text="В игре: 0 ч 0 мин" Foreground="#E4C5FF" FontSize="10" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="PlayButton" Grid.Column="1" Content="▶  ИГРАТЬ" Style="{StaticResource PrimaryButton}" Width="172" Height="56" VerticalAlignment="Center" Click="PlayButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

        <Border Background="#130F23" BorderBrush="#593271" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="☀  SOLARIS IGNITION" Foreground="#FFD56A" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock x:Name="IgnitionPercent" Text="ГОТОВО" Foreground="#FFE99B" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold"/>
                                </Grid>
                                <Grid x:Name="IgnitionTrack" Height="16" ClipToBounds="False" SizeChanged="IgnitionTrack_SizeChanged">
                                    <Border Background="#282032" BorderBrush="#735031" BorderThickness="1" CornerRadius="8"/>
                                    <Border x:Name="IgnitionFill" HorizontalAlignment="Left" Width="0" CornerRadius="7" IsHitTestVisible="False">
                                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFF4B1" Offset="0"/><GradientStop Color="#FFE63A" Offset="0.25"/><GradientStop Color="#FF9F11" Offset="0.75"/><GradientStop Color="#B45805" Offset="1"/></LinearGradientBrush></Border.Background>
                                    </Border>
                                    <Border x:Name="IgnitionFront" Width="5" HorizontalAlignment="Left" Background="#FFFFCE" Opacity="0.8" CornerRadius="3" IsHitTestVisible="False"/>
                                    <Canvas x:Name="IgnitionParticles" IsHitTestVisible="False" ClipToBounds="False"/>
                                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" ValueChanged="IgnitionProgress_ValueChanged"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock x:Name="StatusText" Text="Готов к запуску." Foreground="#CEC3D1" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,72,0"/>
                                    <TextBlock x:Name="VersionText" Text="" HorizontalAlignment="Right" Foreground="#7E7185" FontSize="10"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="12" Background="#1B1531" VerticalAlignment="Top"><TextBlock Text="☀" FontSize="20" Foreground="#C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="ЦЕНТР SOLARIS" FontSize="11" FontWeight="SemiBold" Foreground="#B99AFF"/>
                                    <TextBlock Text="Выбери свой мир" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="Vanilla для классического выживания или Modded для сборки Solaris. Состояние установки и обновления отображается ниже карточек серверов." TextWrapping="Wrap" FontSize="10" Foreground="#747D8F" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ПРОФИЛЬ" FontSize="11" FontWeight="SemiBold" Foreground="#737C8D"/>
                                <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="68" Height="68" CornerRadius="12"
                                            Background="#201626" BorderBrush="#B89BFF" BorderThickness="2"
                                            Cursor="Hand" ToolTip="Открыть профиль Solaris"
                                            MouseLeftButtonUp="ProfileAvatar_Click">
                                        <Grid ClipToBounds="True">
                                            <!-- Visible only if no valid local or online skin could be loaded. -->
                                            <Grid x:Name="ProfileAvatarFallback">
                                                <Border CornerRadius="10" Background="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="◈" FontSize="30" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <!-- Real 8x8 Minecraft skin head, including hat/second layer. -->
                                            <Image x:Name="ProfileAvatarImage" Stretch="Fill"
                                                   Visibility="Collapsed" SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Grid>
                                    </Border><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ProfileName" Text="Игрок Solaris" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="● В сети" FontSize="10" Foreground="#86EFAC" Margin="0,5,0,0"/></StackPanel></Grid>
                                <TextBlock x:Name="ProfileText" Text="Локальный аккаунт Solaris" Foreground="#A398B9" FontSize="10" Margin="0,13,0,0" TextWrapping="Wrap"/>
                                <Button Content="↗  Открыть профиль" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" Height="36" FontSize="11" Click="ProfileNav_Click"/>
                                <!-- Profile and activity share one panel. -->
                                <Border BorderBrush="#564062" BorderThickness="0,1,0,0" Margin="0,19,0,17"/>
                                 <TextBlock Text="☀  SOLARIS ACTIVITY" FontSize="11" FontWeight="SemiBold" Foreground="#FFCF73"/>
                                 <TextBlock Text="ПОСЛЕДНЯЯ ИГРА" FontSize="9" Foreground="#998CA8" Margin="0,15,0,4"/>
                                 <TextBlock x:Name="ActivityLastGame" Text="Вы ещё не играли" FontSize="14" FontWeight="SemiBold"/>
                                 <TextBlock Text="ПОСЛЕДНИЙ СЕАНС" FontSize="9" Foreground="#998CA8" Margin="0,13,0,4"/>
                                 <TextBlock x:Name="ActivityLastDuration" Text="0 ч 0 мин" FontSize="13" Foreground="#FFE0A0"/>
                                 <TextBlock Text="ПОСЛЕДНИЙ ЗАПУСК" FontSize="9" Foreground="#998CA8" Margin="0,13,0,4"/>
                                 <TextBlock x:Name="ActivityLastLaunch" Text="—" FontSize="12" Foreground="#D3C6DD"/>
                             </StackPanel>
                         </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="SOLARIS LAUNCHER • Minecraft 26.2 / 1.20.1 Forge" FontSize="9" Foreground="#4D5563"/>
        </Grid>
        </Grid>

        <!-- Built-in Neon panels: keep gameplay views in the same WPF window. -->
        <Grid x:Name="SettingsView" Grid.Row="1" Margin="12" Visibility="Collapsed" Background="#100D20" Panel.ZIndex="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="780" HorizontalAlignment="Center" Margin="28,18" Width="710">
                    <Button Content="←  НАЗАД К МИРАМ" Style="{StaticResource NavButton}" HorizontalAlignment="Left" Click="BackToHome_Click"/>
                    <TextBlock Text="⚙  НАСТРОЙКИ SOLARIS" FontSize="27" FontWeight="Bold" Foreground="#FFE1A0" Margin="0,24,0,5"/>
                    <TextBlock Text="Память игры • безопасные ограничения" FontSize="12" Foreground="#AE9DB8" Margin="0,0,0,24"/>
                    <Border Background="#1A1729" BorderBrush="#584368" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="SOLARIS VANILLA" Foreground="#FFD27C" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Minecraft 26.2" Foreground="#B9AABA" FontSize="11" Margin="0,4,0,12"/>
                            <TextBlock x:Name="VanillaRamText" Text="3072 МБ" FontSize="19" FontWeight="Bold" Foreground="#FFE2A0"/>
                            <Slider x:Name="VanillaRamSlider" Minimum="2048" Maximum="4096" Value="3072" TickFrequency="512" IsSnapToTickEnabled="True" Height="34" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A1729" BorderBrush="#584368" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="SOLARIS MODDED" Foreground="#D8B2FF" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="Minecraft 1.20.1 • Forge 47.4.20" Foreground="#B9AABA" FontSize="11" Margin="0,4,0,12"/>
                            <TextBlock x:Name="ModdedRamText" Text="4096 МБ" FontSize="19" FontWeight="Bold" Foreground="#FFE2A0"/>
                            <Slider x:Name="ModdedRamSlider" Minimum="2048" Maximum="4096" Value="4096" TickFrequency="512" IsSnapToTickEnabled="True" Height="34" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="RamSafetyText" Text="Solaris сохраняет достаточно памяти для Windows." Foreground="#E5C885" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="Настройки сохраняются отдельно от Minecraft и не сбрасываются при обновлениях." Foreground="#9C92A9" FontSize="11" Margin="0,12,0,15" TextWrapping="Wrap"/>
                    <Button Content="🎨  Импортировать оформление" Style="{StaticResource SecondaryButton}" Click="ImportNeonArtwork_Click" Width="245" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ProfileView" Grid.Row="1" Margin="12" Visibility="Collapsed" Background="#100D20" Panel.ZIndex="21">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="780" Width="710" HorizontalAlignment="Center" Margin="28,18">
                    <Button Content="←  НАЗАД К МИРАМ" Style="{StaticResource NavButton}" HorizontalAlignment="Left" Click="BackToHome_Click"/>
                    <TextBlock Text="☀  SOLARIS PLAYER PROFILE" FontSize="27" FontWeight="Bold" Foreground="#FFE1A0" Margin="0,24,0,16"/>
                    <Border Background="#201A30" BorderBrush="#715144" BorderThickness="1" CornerRadius="18" Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="FullProfileName" Text="Игрок Solaris" FontSize="24" FontWeight="Bold" Foreground="#FFE1A0"/>
                            <TextBlock x:Name="FullProfileStatus" Text="Локальный аккаунт Solaris" FontSize="11" Foreground="#BAADC6" Margin="0,5,0,0"/>
                            <TextBlock x:Name="FullProfileCreated" Text="Дата регистрации: неизвестна" FontSize="11" Foreground="#BAADC6" Margin="0,5,0,0"/>
                            <TextBlock x:Name="FullProfileTotal" Text="Всего в Minecraft: 0 ч 0 мин" FontSize="18" FontWeight="Bold" Foreground="#FFD16E" Margin="0,18,0,0"/>
                            <TextBlock x:Name="FullProfileVanilla" Text="Vanilla: 0 ч 0 мин" Foreground="#E5DCED" FontSize="12" Margin="0,12,0,0"/>
                            <TextBlock x:Name="FullProfileModded" Text="Modded: 0 ч 0 мин" Foreground="#E5DCED" FontSize="12" Margin="0,7,0,0"/>
                            <StackPanel x:Name="CloudLegacyImportPanel" Visibility="Collapsed" Margin="0,17,0,0">
                                <TextBlock Text="ПЕРЕНЕСТИ СТАРЫЙ ЛОКАЛЬНЫЙ ПРОФИЛЬ"
                                           Foreground="#FFD582" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Нужен старый локальный пароль. Данные и аккаунт на ПК сохранятся."
                                           FontSize="11" Foreground="#B4A9C0" TextWrapping="Wrap" Margin="0,6,0,9"/>
                                <PasswordBox x:Name="LegacyPasswordBox" Style="{StaticResource PasswordBoxStyle}"
                                             ToolTip="Пароль старого локального аккаунта"/>
                                <Button Content="Перенести игровые часы" Margin="0,9,0,0" Height="36"
                                        Style="{StaticResource SecondaryButton}" Click="CloudLegacyImport_Click"/>
                                <TextBlock x:Name="LegacyImportStatus" Foreground="#FFD37D" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                            <Button x:Name="OpenControlButton" Content="⚙  SOLARIS CONTROL"
                                    Margin="0,20,0,0" Height="38" Visibility="Collapsed"
                                    Style="{StaticResource SecondaryButton}" Click="ControlOpen_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A1729" BorderBrush="#584368" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="СКИН MINECRAFT" FontSize="13" FontWeight="SemiBold" Foreground="#FFE2A6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                                <Button Content="2D" x:Name="ProfileSkin2DButton" Style="{StaticResource SecondaryButton}" Width="85" Click="ProfileSkin2D_Click"/>
                                <Button Content="3D ↻" x:Name="ProfileSkin3DButton" Style="{StaticResource SecondaryButton}" Width="90" Margin="10,0,0,0" Click="ProfileSkin3D_Click"/>
                                <Button Content="Загрузить PNG" Style="{StaticResource SecondaryButton}" Width="175" Margin="15,0,0,0" Click="ProfileSkinImport_Click"/>
                            </StackPanel>
                            <Grid Height="240" Background="#141321">
                                <Image x:Name="ProfileFullSkin2D" Stretch="Uniform" Margin="20" Visibility="Visible"/>
                                <Viewport3D x:Name="ProfileFullSkin3D" Visibility="Collapsed" MouseLeftButtonDown="ProfileModel_MouseDown" MouseMove="ProfileModel_MouseMove" MouseLeftButtonUp="ProfileModel_MouseUp"/>
                            </Grid>
                            <TextBlock Text="В 3D вращай персонажа мышью. Можно установить свой PNG-скин 64×64." Foreground="#A79DB3" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ControlView" Grid.Row="1" Visibility="Collapsed" Background="#100D20"
              Margin="12" Panel.ZIndex="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="800" HorizontalAlignment="Center" Margin="25,16">
                    <Button Content="←  К ПРОФИЛЮ" Style="{StaticResource NavButton}"
                            HorizontalAlignment="Left" Click="ControlBack_Click"/>
                    <TextBlock Text="☀  SOLARIS CONTROL" Foreground="#FFE0A0" FontWeight="Bold"
                               FontSize="27" Margin="0,18,0,8"/>
                    <TextBlock Text="Администрирование Solaris ID — только с подтверждённой 2FA"
                               Foreground="#AEA1BC" FontSize="12" Margin="0,0,0,16"/>
                    <Border Background="#1C172C" BorderBrush="#715144" BorderThickness="1" Padding="20" CornerRadius="15">
                        <StackPanel>
                            <TextBlock Text="Поиск аккаунта: ник или email (не менее 2 символов)"
                                       FontSize="12" Foreground="#D2C4D9"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox x:Name="ControlSearchBox" Style="{StaticResource InputBox}" Width="520"/>
                                <Button Content="НАЙТИ" Width="130" Style="{StaticResource SecondaryButton}"
                                        Margin="12,0,0,0" Click="ControlSearch_Click"/>
                            </StackPanel>
                            <ListBox x:Name="ControlAccountsList" Margin="0,14,0,0" Height="160"
                                     Background="#0F0D1D" Foreground="#EEE5F3" BorderBrush="#57416D"/>
                            <TextBlock Text="Причина действия (записывается в журнал):"
                                       Foreground="#D2C4D9" FontSize="12" Margin="0,15,0,6"/>
                            <TextBox x:Name="ControlReasonBox" Style="{StaticResource InputBox}"
                                     Text="Нарушение правил сервера" MaxLength="256"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="ЗАБЛОКИРОВАТЬ" Tag="ban"
                                        Width="160" Style="{StaticResource SecondaryButton}"
                                        Click="ControlAccountAction_Click"/>
                                <Button Content="РАЗБЛОКИРОВАТЬ" Tag="unban"
                                        Margin="10,0,0,0" Width="165" Style="{StaticResource SecondaryButton}"
                                        Click="ControlAccountAction_Click"/>
                                <Button Content="ОТКЛЮЧИТЬ СЕССИИ" Tag="revoke"
                                        Margin="10,0,0,0" Width="180" Style="{StaticResource SecondaryButton}"
                                        Click="ControlAccountAction_Click"/>
                                <Button Content="СБРОС ПО ПОЧТЕ" Tag="reset-password"
                                        Margin="10,0,0,0" Width="165" Style="{StaticResource SecondaryButton}"
                                        Click="ControlAccountAction_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ControlStatus" Foreground="#FFD789" FontSize="12"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <Button Content="ПОКАЗАТЬ ЖУРНАЛ ДЕЙСТВИЙ"
                            Style="{StaticResource SecondaryButton}" Margin="0,16,0,0"
                            HorizontalAlignment="Left" Click="ControlAudit_Click"/>
                    <TextBlock x:Name="ControlAuditText" Foreground="#BFB4C9" TextWrapping="Wrap"
                               FontSize="11" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>