<Window x:Class="SolarisLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solaris Launcher" Width="1180" Height="760" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#090B0D" Foreground="#F5F5F5" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#15181A"/>
        <SolidColorBrush x:Key="PanelDark" Color="#101214"/>
        <SolidColorBrush x:Key="Line" Color="#303437"/>
        <SolidColorBrush x:Key="Muted" Color="#8B9295"/>
        <SolidColorBrush x:Key="Orange" Color="#F2A34A"/>
        <SolidColorBrush x:Key="OrangeHover" Color="#FFC06A"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/><Setter Property="Padding" Value="22,0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#16110A"/><Setter Property="Background" Value="{StaticResource Orange}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource OrangeHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="Background" Value="#24282A"/><Setter Property="BorderBrush" Value="#3A3E40"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#C8CDCF"/><Setter Property="Padding" Value="10,6"/></Style>
        <Style x:Key="InputBox" TargetType="TextBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#101315"/><Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#101315"/><Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="AuthView" Margin="30">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="24,0,70,0">
                <StackPanel Orientation="Horizontal"><Border Width="54" Height="54" CornerRadius="16" Background="{StaticResource Orange}" Margin="0,0,15,0"><TextBlock Text="☀" FontSize="30" Foreground="#17120A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="SOLARIS" FontSize="38" FontWeight="Bold"/><TextBlock Text="MINECRAFT UNIVERSE" FontSize="11" Foreground="#777E81"/></StackPanel></StackPanel>
                <TextBlock Text="Твой Minecraft. Твой мир. Твой Solaris." FontSize="24" FontWeight="SemiBold" Margin="0,40,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Один лаунчер для Vanilla и Modded приключений." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="34" VerticalAlignment="Center">
                <StackPanel><TextBlock x:Name="AuthTitle" Text="Вход в аккаунт" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Логин" Margin="0,28,0,8" Foreground="{StaticResource Muted}"/><TextBox x:Name="LoginBox" Style="{StaticResource InputBox}"/><TextBlock Text="Пароль" Margin="0,16,0,8" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}"/><TextBlock x:Name="AuthStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#E98C8C"/><Button x:Name="AuthActionButton" Content="ВОЙТИ" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Click="AuthActionButton_Click"/><Button x:Name="SwitchAuthButton" Content="Создать аккаунт" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="SwitchAuthButton_Click"/><TextBlock Text="Аккаунт хранится локально на этом ПК." Margin="0,18,0,0" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="MainView" Visibility="Collapsed" Background="#090B0D">
            <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- LEFT SERVER LIST -->
            <Border Grid.Column="0" Background="#111416" BorderBrush="#2B2F31" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,13,10,10">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Orange}" Margin="0,0,10,0"><TextBlock Text="☀" FontSize="21" Foreground="#17120A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="SOLARIS" FontSize="18" FontWeight="Bold"/><TextBlock Text="SERVERS" FontSize="8" Foreground="#777E81"/></StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#1A1E20" BorderBrush="#383D40" BorderThickness="0,0,0,1" Padding="13,10" Margin="0,0,0,1">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="7" Background="#F2A34A"><TextBlock Text="☀" Foreground="#17120A" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,5,0"><TextBlock Text="Classic" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="18 / 100" FontSize="10" Foreground="#858C8F"/></StackPanel><Ellipse Grid.Column="2" Width="7" Height="7" Fill="#4ADE80" VerticalAlignment="Center"/></Grid>
                            </Border>
                            <Border Background="#141719" Padding="13,10" Margin="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="7" Background="#252A2C"><TextBlock Text="⚙" Foreground="#B6BDC0" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Solaris Modded" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Forge • скоро" FontSize="10" Foreground="#777E81"/></StackPanel></Grid></Border>
                            <Border Background="#141719" Padding="13,10" Margin="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="7" Background="#202426"><TextBlock Text="＋" Foreground="#7D8588" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="Другие серверы" Foreground="#777E81" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="#0D1012" BorderBrush="#25292B" BorderThickness="0,1,0,0" Padding="14,10">
                        <StackPanel><TextBlock Text="АККАУНТ" FontSize="8" Foreground="#737A7D"/><TextBlock x:Name="WelcomeText" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/><Button Content="Выйти" Style="{StaticResource NavButton}" HorizontalAlignment="Left" Margin="-10,2,0,0" Click="LogoutButton_Click"/></StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT SERVER CONTENT -->
            <Grid Grid.Column="1" Margin="22,0,22,0">
                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="SOLARIS VANILLA  •  КЛАССИЧЕСКИЙ СЕРВЕР" Foreground="#C8CDCF" FontSize="12" VerticalAlignment="Center"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#0F1214" BorderBrush="#34383A" BorderThickness="1" Padding="0" Margin="0,0,0,14">
                            <StackPanel>
                                <Border Height="190" Clip="{x:Null}"><Grid><Image Source="/Assets/vanilla-server.jpg" Stretch="UniformToFill"/><Rectangle Fill="#180E07" Opacity="0.16"/></Grid></Border>
                                <Border Height="2" Background="{StaticResource Orange}"/>
                                <StackPanel Padding="18,15,18,18">
                                    <TextBlock Text="Добро пожаловать на Solaris Classic!" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Это то место, где можно обрести свободу для Ваших фантазий. Здесь установлен только базовый модуль, обеспечивающий интересную игру. Сервер подходит для профи, которые могут похвастаться своими завораживающими постройками, и для тех, кто только-только начинает играть!" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="#C4C9CB" Margin="0,12,0,0"/>
                                    <TextBlock Text="Сервер: solarisplay.millida.host:25565" FontSize="10" Foreground="#858C8F" Margin="0,12,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center"/><TextBlock Text=" Сервер готов" FontSize="11" Foreground="#86EFAC"/><TextBlock Text="  •  Minecraft 26.2" FontSize="10" Foreground="#858C8F" Margin="10,0,0,0"/></StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#111416" BorderBrush="#2D3234" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SOLARIS VANILLA" FontSize="14" FontWeight="Bold"/><TextBlock Text="Minecraft 26.2 • Survival" FontSize="11" Foreground="#8A9194" Margin="0,5,0,0"/><TextBlock Text="Подключение к серверу будет выполнено автоматически." FontSize="10" Foreground="#71787B" Margin="0,5,0,0"/></StackPanel><Button x:Name="VanillaPlayButton" Grid.Column="1" Content="ИГРАТЬ" Style="{StaticResource PrimaryButton}" Width="132" Height="48" VerticalAlignment="Center" Click="VanillaPlayButton_Click"/></Grid>
                        </Border>

                        <Border Background="#111416" BorderBrush="#2D3234" BorderThickness="1" Padding="18">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SOLARIS MODDED" FontSize="14" FontWeight="Bold"/><TextBlock Text="Minecraft 1.20.1 • Forge 47.4.20" FontSize="11" Foreground="#8A9194" Margin="0,5,0,0"/><TextBlock Text="Модовая сборка Solaris — готовится." FontSize="10" Foreground="#71787B" Margin="0,5,0,0"/></StackPanel><Button x:Name="PlayButton" Grid.Column="1" Content="ИГРАТЬ" Style="{StaticResource SecondaryButton}" Width="132" Height="48" VerticalAlignment="Center" Click="PlayButton_Click"/></Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#0D1012" BorderBrush="#25292B" BorderThickness="0,1,0,0" Padding="0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Готов к запуску." FontSize="10" Foreground="#8B9295"/><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0"/><TextBlock x:Name="VersionText" Text="" FontSize="9" Foreground="#5E6568" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="ПАМЯТЬ" FontSize="8" Foreground="#737A7D"/><DockPanel Margin="0,4,0,0"><Slider x:Name="RamSlider" Minimum="2048" Maximum="4096" TickFrequency="512" IsSnapToTickEnabled="True" Value="3072" ValueChanged="RamSlider_ValueChanged" Width="145"/><TextBlock x:Name="RamText" Text="3072 MB" Width="62" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="#C8CDCF"/></DockPanel></StackPanel></Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>