<Window x:Class="SolarisLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solaris Launcher" Width="1320" Height="820" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#090716" Foreground="#F5F7FA" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#E00F0C1F"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#281933"/>
        <SolidColorBrush x:Key="Panel3Brush" Color="#0D0919"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#563C6E"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#BAB0D0"/>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#8D35FC" Offset="0"/><GradientStop Color="#D43CCF" Offset="0.65"/><GradientStop Color="#FF9D3F" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#A358FF" Offset="0"/><GradientStop Color="#FA59BD" Offset="0.65"/><GradientStop Color="#FFBB54" Offset="1"/></LinearGradientBrush>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/><Setter Property="Padding" Value="20,0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="{StaticResource Panel2Brush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#AAB3C2"/><Setter Property="Padding" Value="10,7"/></Style>
        <Style x:Key="InputBox" TargetType="TextBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#0C111A"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#0C111A"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="AvatarRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Width="122" Height="116" Background="#121722" BorderBrush="#252B38" BorderThickness="1" CornerRadius="14" Padding="10"><StackPanel HorizontalAlignment="Center"><Border Width="54" Height="54" CornerRadius="27" Background="#8B5CF6"><TextBlock Text="S" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#A078FF"/><Setter TargetName="Card" Property="Background" Value="#1A1730"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#100B25" Offset="0"/><GradientStop Color="#090715" Offset="0.60"/><GradientStop Color="#190D22" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Grid x:Name="AuthView">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.22*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" CornerRadius="20" ClipToBounds="True" BorderBrush="#C445AE" BorderThickness="1">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#14082B" Offset="0"/><GradientStop Color="#663071" Offset="0.44"/><GradientStop Color="#DA653E" Offset="0.72"/><GradientStop Color="#210A29" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
            <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True" Opacity="0.80">
                <Ellipse Canvas.Left="86" Canvas.Top="110" Width="410" Height="410" Stroke="#FF9C47" StrokeThickness="18" Fill="#2C0B35"/>
                <Ellipse Canvas.Left="104" Canvas.Top="128" Width="374" Height="374" Stroke="#D85EF0" StrokeThickness="5" Fill="#371240"/>
                <Ellipse Canvas.Left="124" Canvas.Top="148" Width="334" Height="334" Stroke="#A43BE7" StrokeThickness="2" Fill="#401747"/>
                <Polygon Points="0,635 105,568 150,598 252,506 300,540 398,475 565,619 680,566 800,692 800,850 0,850" Fill="#1B112B"/>
                <Polygon Points="18,760 110,690 160,718 250,600 330,660 430,590 480,650 600,570 715,732 715,850 18,850" Fill="#2B1744" Opacity="0.8"/>
                <Rectangle Canvas.Left="235" Canvas.Top="275" Width="48" Height="84" Fill="#2D164F" Opacity="0.5"/>
                <Rectangle Canvas.Left="560" Canvas.Top="110" Width="45" Height="230" Fill="#28124D" Opacity="0.7"/>
                <Rectangle Canvas.Left="614" Canvas.Top="56" Width="17" Height="330" Fill="#A943E4" Opacity="0.6"/>
                <Rectangle Canvas.Left="380" Canvas.Top="420" Width="28" Height="156" Fill="#D460C9" Opacity="0.45"/>
            </Canvas>
            <Border Grid.ColumnSpan="2" CornerRadius="20" IsHitTestVisible="False">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5"><GradientStop Color="#680A0520" Offset="0"/><GradientStop Color="#A4120925" Offset="0.56"/><GradientStop Color="#F1090719" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
            <Border Grid.Column="0" Background="#230B0519" IsHitTestVisible="False" CornerRadius="20"/>
            <Grid Grid.Column="0" Margin="48,36,18,54" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Grid Width="70" Height="70"><Polygon Fill="#FFAE56" Points="35,0 44,12 58,5 58,21 70,35 58,45 62,60 46,58 35,70 24,58 8,62 12,46 0,35 12,24 8,8 24,12"/><Polygon Fill="#200E30" Points="35,13 55,24 55,46 35,57 15,46 15,24"/><Polygon Stroke="#FFBF76" StrokeThickness="3" Fill="#411638" Points="35,21 47,28 47,42 35,49 23,42 23,28"/></Grid>
                    <TextBlock Text="SOLARIS" FontSize="56" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="17,0,0,0" Foreground="#FFF3FB"/>
                </StackPanel>
            </Grid>
            <Border Grid.Column="1" Margin="26,50,38,50" VerticalAlignment="Center" Padding="38" CornerRadius="22" BorderThickness="1.5">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F316102A" Offset="0"/><GradientStop Color="#F40B0A1E" Offset="0.7"/><GradientStop Color="#F5211021" Offset="1"/></LinearGradientBrush></Border.Background>
                <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#AF39FD" Offset="0"/><GradientStop Color="#703D80" Offset="0.45"/><GradientStop Color="#FF883C" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
                <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="#7520A6" Opacity="0.5"/></Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="AuthTitle" Text="Вход в аккаунт" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="Добро пожаловать в Solaris" Foreground="#C4B6D5" FontSize="13" Margin="0,6,0,20"/>
                    <TextBlock Text="Логин" Foreground="#D9D0E6" FontSize="12" Margin="0,8,0,7"/>
                    <TextBox x:Name="LoginBox" Style="{StaticResource InputBox}"/>
                    <TextBlock Text="Пароль" Foreground="#D9D0E6" FontSize="12" Margin="0,20,0,7"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}"/>
                    <CheckBox x:Name="RememberMeCheck" Content="Запомнить меня" IsChecked="False" Foreground="#DCD1EC" FontSize="12" Margin="2,20,0,0" Cursor="Hand"/>
                    <TextBlock x:Name="AuthStatus" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFACB3" FontSize="11"/>
                    <Button x:Name="AuthActionButton" Content="ВОЙТИ  ›" Style="{StaticResource PrimaryButton}" Height="52" FontSize="15" Margin="0,22,0,0" Click="AuthActionButton_Click"/>
                    <Button x:Name="SwitchAuthButton" Content="Создать аккаунт" Style="{StaticResource SecondaryButton}" Height="48" Margin="0,12,0,0" Click="SwitchAuthButton_Click"/>
                    <Border BorderBrush="#443250" BorderThickness="0,1,0,0" Margin="0,29,0,0"/>
                    <TextBlock Text="Аккаунт хранится локально на этом ПК." Margin="0,18,0,0" HorizontalAlignment="Center" Foreground="#92839E" FontSize="10"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="MainView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="70" Height="70"><Polygon Fill="#FFAE56" Points="35,0 44,12 58,5 58,21 70,35 58,45 62,60 46,58 35,70 24,58 8,62 12,46 0,35 12,24 8,8 24,12"/><Polygon Fill="#200E30" Points="35,13 55,24 55,46 35,57 15,46 15,24"/><Polygon Stroke="#FFBF76" StrokeThickness="3" Fill="#411638" Points="35,21 47,28 47,42 35,49 23,42 23,28"/></Grid><StackPanel VerticalAlignment="Center" Margin="13,0,0,0"><TextBlock Text="SOLARIS" FontSize="30" FontWeight="ExtraBold"/><TextBlock Text="MINECRAFT UNIVERSE" FontSize="9" Foreground="#C9A4D8" Margin="2,0,0,0"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Padding="23,11" CornerRadius="12" Background="#512299" BorderBrush="#AA45F8" BorderThickness="1"><TextBlock Text="⬡  Миры" FontSize="14" FontWeight="SemiBold" Foreground="White"/></Border>
                    <TextBlock Text="⚙  Настройки" VerticalAlignment="Center" Margin="25,0,0,0" Foreground="#C3B7D0" FontSize="13"/>
                    <TextBlock Text="▤  Новости" VerticalAlignment="Center" Margin="25,0,0,0" Foreground="#C3B7D0" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="WelcomeText" HorizontalAlignment="Right" FontSize="15" FontWeight="Bold"/><Button Content="Выйти" Style="{StaticResource NavButton}" HorizontalAlignment="Right" Click="LogoutButton_Click"/></StackPanel>
            </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,12"><TextBlock Text="МИРЫ" FontSize="12" FontWeight="SemiBold" Foreground="#747D8F"/><Border Background="#1B1531" CornerRadius="8" Padding="8,3" Margin="10,0,0,0"><TextBlock Text="2 РЕЖИМА" FontSize="9" Foreground="#B99AFF"/></Border></StackPanel>

                        <Border x:Name="VanillaCard" Background="#161023" BorderBrush="#FF954F" BorderThickness="1.5" CornerRadius="18" Margin="0,0,0,14" MouseEnter="VanillaCard_MouseEnter" MouseLeave="VanillaCard_MouseLeave">
                            <Grid Height="186" ClipToBounds="True">
                                <Border CornerRadius="18" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#351742" Offset="0"/><GradientStop Color="#934177" Offset="0.52"/><GradientStop Color="#FF943F" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <Image x:Name="VanillaArtwork" Stretch="UniformToFill" Opacity="0.85" IsHitTestVisible="False"><Image.Effect><BlurEffect Radius="8"/></Image.Effect></Image>
                                <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#F00C091A" Offset="0"/><GradientStop Color="#9E110E23" Offset="0.49"/><GradientStop Color="#48130621" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <Grid Margin="23,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" CornerRadius="11" Background="#FFBB4D"><TextBlock Text="☀" Foreground="#211225" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Margin="11,0,0,0"><TextBlock Text="SOLARIS VANILLA" FontSize="22" FontWeight="Bold"/><TextBlock Text="ОСНОВНОЙ РЕЖИМ" FontSize="10" Foreground="#D3BDD8"/></StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Minecraft 26.2 • Survival" FontSize="13" Margin="0,13,0,0" Foreground="#F0E4EF"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0"><Ellipse Width="8" Height="8" Fill="#3DFFA3" VerticalAlignment="Center"/><TextBlock Text=" Сервер готов" Foreground="#64FFAD" FontSize="11"/><TextBlock Text="  •  25565" Foreground="#D1B7D2" FontSize="10" Margin="8,0,0,0"/></StackPanel>
                                        <TextBlock Text="solarisplay.millida.host:25565" Foreground="#B5A1BC" FontSize="10" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="VanillaPlayButton" Grid.Column="1" Content="▶  ИГРАТЬ" Style="{StaticResource PrimaryButton}" Width="172" Height="56" VerticalAlignment="Center" Click="VanillaPlayButton_Click" MouseEnter="VanillaPlayButton_MouseEnter" MouseLeave="VanillaPlayButton_MouseLeave"/>
                                </Grid>
                            </Grid>
                        </Border>

        <Border x:Name="ModdedCard" Background="#150D26" BorderBrush="#A445E5" BorderThickness="1.5" CornerRadius="18" MouseEnter="ModdedCard_MouseEnter" MouseLeave="ModdedCard_MouseLeave">
                            <Grid Height="175" ClipToBounds="True">
                                <Border CornerRadius="18" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#210B31" Offset="0"/><GradientStop Color="#58258E" Offset="0.6"/><GradientStop Color="#871DA0" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <Image x:Name="ModdedArtwork" Stretch="UniformToFill" Opacity="0.60" IsHitTestVisible="False"><Image.Effect><BlurEffect Radius="12"/></Image.Effect></Image>
                                <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#F00D0620" Offset="0"/><GradientStop Color="#A92C0B4B" Offset="0.5"/><GradientStop Color="#90200437" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <Grid Margin="23,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" CornerRadius="11" Background="#5720AD"><TextBlock Text="⚙" Foreground="#F4D1FF" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Margin="11,0,0,0"><TextBlock Text="SOLARIS MODDED" FontSize="22" FontWeight="Bold"/><TextBlock Text="FORGE СБОРКА" FontSize="10" Foreground="#C3A5DE"/></StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Minecraft 1.20.1 • Forge 47.4.20" FontSize="13" Foreground="#E7D9F1" Margin="0,14,0,0"/>
                                        <TextBlock Text="Модовая сборка Solaris" FontSize="10" Foreground="#BB9BD0" Margin="0,9,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="PlayButton" Grid.Column="1" Content="▶  ИГРАТЬ" Style="{StaticResource PrimaryButton}" Width="172" Height="56" VerticalAlignment="Center" Click="PlayButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

        <Border Background="#130F23" BorderBrush="#593271" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,14,0,0">
                            <Grid><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Value="0"/><Grid Margin="0,9,0,0"><TextBlock x:Name="StatusText" Text="Готов к запуску." Foreground="#737C8D" FontSize="10"/><TextBlock x:Name="VersionText" Text="" HorizontalAlignment="Right" Foreground="#505866" FontSize="10"/></Grid></Grid>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="12" Background="#1B1531" VerticalAlignment="Top"><TextBlock Text="☀" FontSize="20" Foreground="#C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="ЦЕНТР SOLARIS" FontSize="11" FontWeight="SemiBold" Foreground="#B99AFF"/>
                                    <TextBlock Text="Выбери свой мир" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="Vanilla для классического выживания или Modded для сборки Solaris. Состояние установки и обновления отображается ниже карточек серверов." TextWrapping="Wrap" FontSize="10" Foreground="#747D8F" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ПРОФИЛЬ" FontSize="11" FontWeight="SemiBold" Foreground="#737C8D"/>
                                <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="66" Height="66" CornerRadius="33" Background="{StaticResource AccentBrush}" BorderBrush="#B89BFF" BorderThickness="2"><TextBlock Text="S" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="Игрок Solaris" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="● В сети" FontSize="10" Foreground="#86EFAC" Margin="0,5,0,0"/></StackPanel></Grid>
                                <TextBlock x:Name="ProfileText" Text="Версия клиента: Minecraft 1.20.1" Foreground="#727B8C" FontSize="10" Margin="0,13,0,0" TextWrapping="Wrap"/>
                                <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ОНЛАЙН" FontSize="9" Foreground="#60697A"/><TextBlock Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ИГРЫ" FontSize="9" Foreground="#60697A"/><TextBlock Text="0" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="LEVEL" FontSize="9" Foreground="#60697A"/><TextBlock Text="1" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="АВАТАР" FontSize="11" FontWeight="SemiBold" Foreground="#737C8D"/><TextBlock Text="Minecraft skin ↔ Solaris" FontSize="10" Foreground="#60697A" Margin="0,4,0,10"/><RadioButton Content="Голова скина" GroupName="Avatar" IsChecked="True" Style="{StaticResource AvatarRadio}" IsHitTestVisible="False"/></StackPanel></Border>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="НАСТРОЙКИ" FontSize="11" FontWeight="SemiBold" Foreground="#737C8D"/><TextBlock Text="Оперативная память" FontSize="11" Foreground="#AAB2C0" Margin="0,16,0,8"/><DockPanel><Slider x:Name="RamSlider" Minimum="2048" Maximum="4096" TickFrequency="512" IsSnapToTickEnabled="True" Value="3072" ValueChanged="RamSlider_ValueChanged"/><TextBlock x:Name="RamText" Text="3072 MB" Width="70" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10"/></DockPanel><TextBlock Text="Java определяется автоматически" FontSize="9" Foreground="#5E6676" Margin="0,8,0,0"/></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="SOLARIS LAUNCHER • Minecraft 26.2 / 1.20.1 Forge" FontSize="9" Foreground="#4D5563"/>
        </Grid>
    </Grid>
</Window>