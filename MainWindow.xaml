<Window x:Class="SolarisLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solaris Launcher" Width="1180" Height="760" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#080A0F" Foreground="#F5F7FA" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#10131B"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#151923"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#252B38"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8992A3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#9F75F8"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48"/><Setter Property="Padding" Value="22,0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="{StaticResource Panel2Brush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#AAB2C0"/><Setter Property="Padding" Value="12,8"/></Style>
        <Style x:Key="InputBox" TargetType="TextBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#0E131C"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox"><Setter Property="Height" Value="46"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#0E131C"/><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="AvatarRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Width="122" Height="116" Background="#121722" BorderBrush="#252B38" BorderThickness="1" CornerRadius="14" Padding="10"><StackPanel HorizontalAlignment="Center"><Border Width="54" Height="54" CornerRadius="27" Background="#8B5CF6"><TextBlock Text="S" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#9F75F8"/><Setter TargetName="Card" Property="Background" Value="#1A1730"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="34">
        <Grid x:Name="AuthView">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="25,0,70,0">
                <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentBrush}" Margin="0,0,14,0"><TextBlock Text="☀" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="SOLARIS" FontSize="38" FontWeight="Bold"/><TextBlock Text="Minecraft launcher" FontSize="14" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel>
                <Border Margin="0,38,0,0" Padding="20" Background="#10151F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14"><StackPanel><TextBlock Text="1.20.1 • Forge 47.4.20" FontSize="14" Foreground="#C6CEDB"/><TextBlock Text="Клиентская сборка обновляется автоматически" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="34" VerticalAlignment="Center"><StackPanel><TextBlock x:Name="AuthTitle" Text="Вход в аккаунт" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Логин" Margin="0,28,0,8" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="LoginBox" Style="{StaticResource InputBox}"/><TextBlock Text="Пароль" Margin="0,16,0,8" Foreground="{StaticResource MutedBrush}"/><PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}"/><TextBlock x:Name="AuthStatus" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#E98C8C"/><Button x:Name="AuthActionButton" Content="ВОЙТИ" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Click="AuthActionButton_Click"/><Button x:Name="SwitchAuthButton" Content="Создать аккаунт" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="SwitchAuthButton_Click"/><TextBlock Text="В этой версии аккаунт хранится локально на ПК." Margin="0,18,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
        </Grid>
        <Grid x:Name="MainView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"><TextBlock Text="☀" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="SOLARIS" FontSize="24" FontWeight="Bold"/><TextBlock Text="MINECRAFT UNIVERSE" FontSize="10" Foreground="#6F7787"/></StackPanel></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock x:Name="WelcomeText" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"/><Button Content="Выйти" Style="{StaticResource NavButton}" HorizontalAlignment="Right" Click="LogoutButton_Click"/></StackPanel></Grid>
            <Grid Grid.Row="1" Margin="0,28,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="ИГРАТЬ" FontSize="12" FontWeight="SemiBold" Foreground="#747D8F" Margin="2,0,0,10"/>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="26" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="☀" FontSize="22" Foreground="#F6C85F" Margin="0,0,10,0"/><TextBlock Text="SOLARIS VANILLA" FontSize="22" FontWeight="Bold"/></StackPanel><TextBlock Text="Minecraft 26.2 • Survival" FontSize="13" Foreground="#8992A3" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Ellipse Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center"/><TextBlock Text=" Сервер готов" Foreground="#86EFAC" FontSize="12"/></StackPanel><TextBlock Text="solarisplay.millida.host:25565" FontSize="11" Foreground="#5E6676" Margin="0,6,0,0"/></StackPanel><Button x:Name="VanillaPlayButton" Grid.Column="1" Content="ИГРАТЬ" Style="{StaticResource PrimaryButton}" Width="120" VerticalAlignment="Center" Click="VanillaPlayButton_Click"/></Grid></Border>
                    <Border Background="#0D1017" BorderBrush="#202631" BorderThickness="1" CornerRadius="18" Padding="26"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="22" Foreground="#A78BFA" Margin="0,0,10,0"/><TextBlock Text="SOLARIS MODDED" FontSize="22" FontWeight="Bold"/></StackPanel><TextBlock Text="Minecraft 1.20.1 • Forge 47.4.20" FontSize="13" Foreground="#8992A3" Margin="0,10,0,0"/><TextBlock Text="Модовая сборка Solaris" FontSize="11" Foreground="#5E6676" Margin="0,18,0,0"/></StackPanel><Button x:Name="PlayButton" Grid.Column="1" Content="ИГРАТЬ" Style="{StaticResource SecondaryButton}" Width="120" VerticalAlignment="Center" Click="PlayButton_Click"/></Grid></Border>
                    <Border Background="#0C0F15" CornerRadius="14" Padding="18" Margin="0,18,0,0"><Grid><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Value="0"/><Grid Margin="0,10,0,0"><TextBlock x:Name="StatusText" Text="Готов к запуску." Foreground="#737C8D" FontSize="11"/><TextBlock x:Name="VersionText" Text="" HorizontalAlignment="Right" Foreground="#505866" FontSize="11"/></Grid></Grid></Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="22"><StackPanel>
                        <TextBlock Text="ПРОФИЛЬ" FontSize="11" FontWeight="SemiBold" Foreground="#737C8D"/>
                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="66" Height="66" CornerRadius="33" Background="{StaticResource AccentBrush}" BorderBrush="#B89BFF" BorderThickness="2"><TextBlock Text="S" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Игрок Solaris" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="● В сети" FontSize="11" Foreground="#86EFAC" Margin="0,6,0,0"/></StackPanel></Grid>
                        <TextBlock x:Name="ProfileText" Text="Версия клиента: Minecraft 1.20.1" Foreground="#727B8C" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        <Border Background="#0C0F15" CornerRadius="12" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock Text="АВАТАР" FontSize="10" FontWeight="SemiBold" Foreground="#737C8D"/><TextBlock Text="Голова Minecraft-скина" FontSize="10" Foreground="#5E6676" Margin="0,4,0,10"/><RadioButton Content="Голова скина" GroupName="Avatar" IsChecked="True" Style="{StaticResource AvatarRadio}" IsHitTestVisible="False"/></StackPanel></Border>
                    </StackPanel></Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,16,0,0"><StackPanel><TextBlock Text="НАСТРОЙКИ" FontSize="11" FontWeight="SemiBold" Foreground="#737C8D"/><TextBlock Text="Оперативная память" FontSize="12" Foreground="#AAB2C0" Margin="0,18,0,8"/><DockPanel><Slider x:Name="RamSlider" Minimum="2048" Maximum="4096" TickFrequency="512" IsSnapToTickEnabled="True" Value="3072" ValueChanged="RamSlider_ValueChanged"/><TextBlock x:Name="RamText" Text="3072 MB" Width="70" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="Java определяется автоматически" FontSize="10" Foreground="#5E6676" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Background="#0C0F15" CornerRadius="14" Padding="16" Margin="0,16,0,0"><StackPanel><Grid><TextBlock Text="ДОСТИЖЕНИЯ" FontSize="11" FontWeight="SemiBold" Foreground="#737C8D"/><TextBlock x:Name="AchievementsCount" Text="0 / 3" HorizontalAlignment="Right" FontSize="10" Foreground="#8B5CF6"/></Grid><TextBlock x:Name="AchievementWelcome" Text="○  Добро пожаловать — аккаунт создан" FontSize="11" Foreground="#5E6676" Margin="0,12,0,0"/><TextBlock x:Name="AchievementFirstLaunch" Text="○  Первый запуск — запусти Minecraft" FontSize="11" Foreground="#5E6676" Margin="0,8,0,0"/><TextBlock x:Name="AchievementExplorer" Text="○  Исследователь — попробуй Vanilla и Modded" FontSize="11" Foreground="#5E6676" Margin="0,8,0,0"/></StackPanel></Border>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="2" Text="SOLARIS LAUNCHER • Minecraft 26.2 / 1.20.1 Forge" FontSize="10" Foreground="#4D5563"/>
        </Grid>
    </Grid>
</Window>