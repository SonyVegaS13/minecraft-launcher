<UserControl x:Class="SolarisLauncher.PlanetaryHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Home" Focusable="False" Background="#070A13"
             PreviewKeyDown="Home_PreviewKeyDown"
             AutomationProperties.Name="Командный центр Solaris">
    <UserControl.Resources>
        <RadialGradientBrush x:Key="WarmAura"><GradientStop Color="#7AEF881D" Offset="0.52"/><GradientStop Color="#00FF8318" Offset="1"/></RadialGradientBrush>
        <RadialGradientBrush x:Key="PurpleAura"><GradientStop Color="#738F35EE" Offset="0.52"/><GradientStop Color="#00A84FFF" Offset="1"/></RadialGradientBrush>
        <RadialGradientBrush x:Key="WarmSurface" GradientOrigin="0.23,0.19" Center="0.33,0.3" RadiusX="0.76" RadiusY="0.76"><GradientStop Color="#FFD890" Offset="0"/><GradientStop Color="#EA8B39" Offset="0.27"/><GradientStop Color="#9D3D23" Offset="0.61"/><GradientStop Color="#271429" Offset="1"/></RadialGradientBrush>
        <RadialGradientBrush x:Key="PurpleSurface" GradientOrigin="0.24,0.18" Center="0.31,0.25" RadiusX="0.82" RadiusY="0.82"><GradientStop Color="#EBC3FF" Offset="0"/><GradientStop Color="#9660DB" Offset="0.3"/><GradientStop Color="#522880" Offset="0.6"/><GradientStop Color="#110C29" Offset="1"/></RadialGradientBrush>
        <LinearGradientBrush x:Key="PlanetShade" StartPoint="0.1,0.16" EndPoint="0.95,0.8"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#08040711" Offset="0.34"/><GradientStop Color="#9D020310" Offset="0.9"/><GradientStop Color="#CF030511" Offset="1"/></LinearGradientBrush>
        <Style x:Key="PlanetButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="{TemplateBinding Background}"><ContentPresenter/><Ellipse x:Name="FocusRing" Width="334" Height="334" Margin="0,0,0,70" Stroke="#E3D8FF" StrokeThickness="2" StrokeDashArray="2 3" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EBE4FF"/><Setter Property="Background" Value="#CF101627"/>
            <Setter Property="BorderBrush" Value="#60677799"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="17,0"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#D2B0FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
