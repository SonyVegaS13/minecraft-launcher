                    <TextBlock Text="SOLARIS / TELEMETRY" FontSize="9" Foreground="#AFA3DE" Canvas.Left="13" Canvas.Top="11"/>
                    <Path Stroke="#625781" Data="M16,86 L187,86 M16,30 L16,86"/>
                    <Path Fill="#AB5C64A8" Data="M27,61h12v23h-12z M47,49h12v35h-12z M67,35h12v49h-12z M87,54h12v30h-12z M107,42h12v42h-12z M127,31h12v53h-12z M147,53h12v31h-12z M167,44h12v40h-12z"/>
                </Canvas></Border>
                <Border Width="95" Height="61" Canvas.Left="260" Canvas.Top="501" CornerRadius="7" BorderBrush="#425588" BorderThickness="2" Background="#090D21"><Canvas><Ellipse Width="42" Height="29" Canvas.Left="26" Canvas.Top="16" Stroke="#668DDF"/><Path Stroke="#6FADF0" Data="M13,30 L82,30 M47,8 L47,52"/><Ellipse Width="8" Height="8" Canvas.Left="43" Canvas.Top="26" Fill="#B097EE"/></Canvas></Border>
