            <Button x:Name="VanillaPlanet" Width="350" Height="382" Canvas.Left="69" Canvas.Top="173"
                    Style="{StaticResource PlanetButton}" Click="VanillaPlanet_Click" TabIndex="0"
                    MouseEnter="Planet_MouseEnter" MouseLeave="Planet_MouseLeave" GotKeyboardFocus="Planet_GotKeyboardFocus" LostKeyboardFocus="Planet_LostKeyboardFocus" RenderTransformOrigin="0.5,0.411"
